-- The window's one view, laid out as About This Mac: everything on the
-- middle line, the names of the facts right-aligned against it and their
-- values left-aligned from it.
--
--              ( ☀ )
--           Saule Linux
--          Version 26.31
--
--        Computer  HP Mini 210-1001SA
--       Processor  Intel Atom N450 @ 1.66GHz
--        Graphics  Intel GMA 3150
--          Memory  412 MB used of 1 GB
--         Storage  250.06 GB hard disk ·
--                  247.47 GB available
--          Kernel  6.18.64-saule
--         Display  1024 × 600
--  Window manager  0.1.0
--
-- Run in a window on another system (macOS, Windows, a Linux desktop),
-- the name and version at the top are that system's ("macOS", "Version
-- 26.2"), and Saule's own version is a fact below them.
--
-- Every value is what the window manager read from the system (see its
-- `SettingsService.about`); one it couldn't find is a dash. It is asked
-- again every second while the window is open, so the memory in use and
-- the room on the disk are what they are now, not what they were when the
-- window opened.

from uikit import *
from "wmapi" import SystemInfo
from SunMark import SunMark
from SystemWatch import SystemWatch

export class AboutView extends View
  watch: SystemWatch

  static background: Color = Color(0.15, 0.15, 0.17)
  static text: Color = Color(0.95, 0.95, 0.97)
  static dimText: Color = Color(1.0, 1.0, 1.0, 0.55)

  -- How wide the facts' names and values are, either side of the middle.
  static names: float = 110.0
  static values: float = 150.0

  fn init(watch: SystemWatch, key: string? = nil)
    self.super(key)
    self.watch = watch
  end

  -- It has a tick to run: see `View.ticks`.
  fn ticks() -> boolean
    return true
  end

  -- Ask again every `SystemWatch.every` seconds, and build the window
  -- again when what it says changed.
  fn tick(el: Element, dt: float) -> nil
    local bag: table = el.data.scratch
    local waited = ((bag.waited as float?) ?? 0.0) + dt
    if waited < SystemWatch.every then
      bag.waited = waited
      return
    end
    bag.waited = 0.0

    local before = AboutView.said(self.watch.info)
    self.watch.refresh()
    if AboutView.said(self.watch.info) != before then
      el.markNeedsBuild()
    end
  end

  -- Everything the window says of `info`, to tell when it changed.
  static fn said(info: SystemInfo) -> string
    local values: table<string> = {}
    for fact in AboutView.facts(info) do
      Table.insert(values, fact[2])
    end
    local top = AboutView.title(info) .. "\n" .. AboutView.version(info)
    return top .. "\n" .. String.join("\n", values)
  end

  -- Hosted: the window manager runs in a window on another system, which
  -- is the one the window is about.
  static fn hosted(info: SystemInfo) -> boolean
    return info.host != "saule" and info.system != ""
  end

  -- The name at the top: the system's.
  static fn title(info: SystemInfo) -> string
    if AboutView.hosted(info) then
      return info.system
    end
    return "Saule Linux"
  end

  -- The version under it: the system's, which on Saule Linux is Saule's.
  static fn version(info: SystemInfo) -> string
    if AboutView.hosted(info) then
      return info.systemVersion
    end
    return info.saule
  end

  -- The facts shown, in order: each a name and its value.
  static fn facts(info: SystemInfo) -> table<table<string>>
    local facts = {
      {"Model", info.machine},
      {"Processor", AboutView.processor(info)},
      {"Graphics", info.graphics},
      {"Memory", AboutView.memory(info)},
      {"Storage", info.storage},
      {"Kernel", info.kernel},
      {"Display", AboutView.display(info)},
      {"Window Manager", info.wm},
    }
    -- Not at the top, where the system's version is.
    if AboutView.hosted(info) then
      Table.insert(facts, {"Saule", info.saule})
    end
    return facts
  end

  fn body(context: BuildContext) -> View
    local info = self.watch.info
    local text = AboutView.text
    local dim = AboutView.dimText

    local version = "Version " .. AboutView.dash(AboutView.version(info))
    local title = AboutView.title(info)
    local name = Text(title).font(20.0).foregroundStyle(text)
    local said = Text(version).font(11.0).foregroundStyle(dim)
    local rows: table<View> = {}
    for fact in AboutView.facts(info) do
      Table.insert(rows, AboutView.fact(fact[1], fact[2]))
    end
    local center = StackAlignment.Center
    local facts = VStack(alignment: center, spacing: 5.0, children: rows)

    local column = VStack(alignment: StackAlignment.Center, spacing: 4.0) do
      Spacer()
      SunMark().frame(width: 72.0, height: 72.0)
      Spacer().frame(height: 10.0)
      show(name)
      show(said)
      Spacer().frame(height: 16.0)
      show(facts)
      Spacer()
    end
    return column.background(AboutView.background)
  end

  -- One fact: its name right-aligned against the middle, its value from
  -- the middle on, dim, on two lines at most.
  static fn fact(label: string, value: string) -> View
    local name = Text(label).font(11.0).foregroundStyle(AboutView.text)
    local said = Text(AboutView.dash(value)).font(11.0).lineLimit(2)
    local right = name.multilineTextAlignment(TextAlign.Right)
    return HStack(alignment: StackAlignment.Leading, spacing: 8.0) do
      right.frame(width: AboutView.names)
      said.foregroundStyle(AboutView.dimText).frame(width: AboutView.values)
    end
  end

  -- The processor as a Mac names its chip: without the "(R)", "(TM)" and
  -- "CPU" a kernel reports, and how many threads it runs at once.
  static fn processor(info: SystemInfo) -> string
    local name = info.processor
    for noise in {"(R)", "(TM)", " CPU"} do
      name = String.replace(name, noise, "")
    end
    if name != "" and info.cores > 1 then
      name = name .. ", " .. info.cores .. " threads"
    end
    return name
  end

  -- How much memory the computer has, from the kB the system counts:
  -- "512 MB", "1 GB", "1.5 GB", "8 GB".
  --
  -- The system counts a little less than is fitted (the firmware and
  -- the graphics chip keep some back), so the count is taken up to the
  -- next size memory comes in: a quarter of a gigabyte under four, a
  -- whole one from there.
  static fn memory(info: SystemInfo) -> string
    if info.memory <= 0 then
      return ""
    end
    local megabytes = (info.memory + 1023) / 1024
    local step = 1024
    if megabytes < 4096 then
      step = 256
    end
    local fitted = (megabytes + step - 1) / step * step
    if fitted < 1024 then
      return fitted .. " MB"
    end
    if fitted % 1024 == 0 then
      return (fitted / 1024) .. " GB"
    end
    local said = String.format("%.2f", (fitted as float) / 1024.0)
    if String.ends(said, "0") then
      said = String.sub(said, 1, String.len(said) - 1)
    end
    return said .. " GB"
  end

  static fn display(info: SystemInfo) -> string
    if info.screenWidth <= 0 then
      return ""
    end
    return info.screenWidth .. " × " .. info.screenHeight
  end

  static fn dash(value: string) -> string
    if value == "" then
      return "—"
    end
    return value
  end
end
