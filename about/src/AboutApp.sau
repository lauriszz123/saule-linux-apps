-- About This System as a uikit app: one small window that can't be resized,
-- so the window manager floats it in the middle of the screen, as a Mac
-- shows About This Mac.

from uikit import *
from "wmapi" import WmApp
from AboutView import AboutView
from SystemWatch import SystemWatch

export class AboutApp extends App
  watch: SystemWatch

  fn init()
    self.super()
    self.watch = SystemWatch()
    WmApp.describe("About This System", Project.version, "What this computer is.")
  end

  fn body() -> Scene
    local title = "About This System"
    return WindowGroup(title: title, width: 300, height: 400, resizable: false) do
      AboutView(self.watch)
    end
  end
end
