-- About This System as a uikit app: one small window that can't be resized,
-- so the window manager floats it in the middle of the screen, as a Mac
-- shows About This Mac.

from uikit import *
from "wmapi" import SystemInfo, WmService, WmSettings
from AboutView import AboutView
from log import Logger

export class AboutApp extends App
  info: SystemInfo

  fn init()
    self.super()
    self.info = AboutApp.ask()
  end

  fn body() -> Scene
    local title = "About This System"
    return WindowGroup(title: title, width: 300, height: 370, resizable: false) do
      AboutView(self.info)
    end
  end

  -- What the window manager knows about the system; nothing known when it
  -- can't be reached (run on its own), which shows as dashes.
  static fn ask() -> SystemInfo
    try
      return WmSettings.connect(WmService.name).about()
    catch e: string
      Logger("about").warn("window manager unreachable", {reason: e})
      return SystemInfo()
    end
  end
end
