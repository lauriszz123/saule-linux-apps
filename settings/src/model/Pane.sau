-- The panes Settings has, in the order the sidebar lists them.

export enum Pane
  Windows,
  Appearance,
  Wallpaper,
  Keyboard,
  Mouse,
  Storage,
  About

  fn title() -> string
    return match self
      case Pane.Windows then "Windows"
      case Pane.Appearance then "Appearance"
      case Pane.Wallpaper then "Wallpaper"
      case Pane.Keyboard then "Keyboard"
      case Pane.Mouse then "Mouse"
      case Pane.Storage then "Storage"
      case Pane.About then "About"
    end
  end
end
