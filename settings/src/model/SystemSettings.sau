-- The window manager's settings, and the connection they come through.
--
-- Everything here is a copy: the window manager holds the real values,
-- and `apply` sends the whole set back. If the window manager can't be
-- reached — Settings run on its own, or the window manager gone — this
-- says why, and changing anything does nothing until `connect` succeeds.

from "wmapi" import KeyActions, MachineInfo, StorageReport, SystemInfo, WmOptions
from "wmapi" import WmService
from "wmapi" import WmSettings
from log import Logger

export class SystemSettings
  static local log: Logger = Logger("settings")

  options: WmOptions
  info: SystemInfo

  -- The disks and what is on them, asked for when the Storage pane opens.
  storage: StorageReport

  -- The computer: what it has and how each thing stands, asked for again
  -- every second or so (`refreshMachine`), since a key, the bar or a
  -- plug changes it from outside.
  machine: MachineInfo

  -- The keyboard layouts and the time zones there are to choose from, as
  -- the window manager lists them (`WmSettings.layouts`, `zones`): asked
  -- for once, when first wanted.
  local layoutList: table<string>?
  local zoneList: table<string>?

  -- Every shortcut as the window manager has it now, by action, and
  -- "mod" (see `WmSettings.keys`).
  keys: table<string, string>

  -- Every key comes to Settings, while a shortcut is recorded.
  recording: boolean

  -- Why there is no connection, or "" when there is one.
  problem: string

  local wm: WmSettings?

  fn init()
    self.options = WmOptions()
    self.info = SystemInfo()
    self.storage = StorageReport()
    self.machine = MachineInfo()
    self.layoutList = nil
    self.zoneList = nil
    self.keys = {}
    self.recording = false
    self.problem = ""
    self.wm = nil
    self.connect()
  end

  fn connected() -> boolean
    return self.wm != nil
  end

  -- Reach the window manager, and read what it has.
  fn connect() -> nil
    try
      local wm = WmSettings.connect(WmService.name)
      self.options = wm.options()
      self.info = wm.about()
      self.keys = wm.keys()
      self.machine = wm.machine()
      self.wm = wm
      self.problem = ""
      SystemSettings.log.debug("connected", {service: WmService.name})
    catch e: string
      self.lose(e)
    end
  end

  -- Send `options` as they are now, and keep what the window manager
  -- made of them: it keeps values to sensible ranges.
  fn apply() -> nil
    local wm = self.wm
    if wm == nil then
      return
    end
    try
      wm!.apply(self.options)
      self.options = wm!.options()
      self.keys = wm!.keys()
      SystemSettings.log.debug("applied")
    catch e: string
      self.lose(e)
    end
  end

  -- The keys of the action `name` (see `KeyActions`) as they are now:
  -- {"ctrl", "alt", "d"}.
  fn shortcut(name: string) -> table<string>
    return KeyActions.split(self.keys[name] ?? "")
  end

  -- Let every key through to Settings while a shortcut is recorded, the
  -- window manager's own too; or stop.
  fn recordKeys(on: boolean) -> nil
    local wm = self.wm
    if wm == nil or on == self.recording then
      return
    end
    self.recording = on
    try
      wm!.recordKeys(on)
    catch e: string
      self.lose(e)
    end
  end

  -- Ask again what the system is like: the About pane shows it fresh.
  fn refreshInfo() -> nil
    local wm = self.wm
    if wm == nil then
      return
    end
    try
      self.info = wm!.about()
    catch e: string
      self.lose(e)
    end
  end

  -- Ask again what is on the disks: the Storage pane shows it fresh.
  fn refreshStorage() -> nil
    local wm = self.wm
    if wm == nil then
      return
    end
    try
      self.storage = wm!.storage()
    catch e: string
      self.lose(e)
    end
  end

  -- Ask again how the computer stands. True when anything Settings
  -- shows of it changed.
  fn refreshMachine() -> boolean
    local wm = self.wm
    if wm == nil then
      return false
    end
    try
      local before = SystemSettings.said(self.machine)
      self.machine = wm!.machine()
      return SystemSettings.said(self.machine) != before
    catch e: string
      self.lose(e)
      return true
    end
  end

  -- Everything of `machine` as one text, to tell when any of it changed.
  static fn said(machine: MachineInfo) -> string
    local parts: table<string> = {
      tostring(machine.managed),
      tostring(machine.soundCard),
      tostring(machine.volume),
      tostring(machine.muted),
      tostring(machine.backlight),
      tostring(machine.brightness),
      tostring(machine.wired),
      tostring(machine.cable),
      machine.wiredAddress,
      machine.radio,
      machine.wifi,
      machine.wifiName,
      tostring(machine.wifiSignal),
      machine.wifiAddress,
      tostring(machine.battery),
      tostring(machine.charge),
      tostring(machine.charging),
      machine.name,
      machine.timeZone,
      machine.person,
      machine.account,
      tostring(machine.hasPassword),
      tostring(machine.passwordChanges),
      machine.passwordChange,
      machine.layout,
      tostring(machine.microphone),
      tostring(machine.inputVolume),
      tostring(machine.inputMuted),
      machine.headphones,
      machine.bluetooth,
      tostring(machine.bluetoothScanning),
      machine.passkey,
      tostring(machine.clockSynced),
    }
    for output in machine.outputs do
      Table.insert(parts, output.name .. tostring(output.chosen))
    end
    for device in machine.bluetoothDevices do
      Table.insert(
        parts,
        device.address .. device.name .. tostring(device.paired) .. tostring(
          device.connected
        )
      )
    end
    for device in machine.devices do
      Table.insert(parts, device.kind .. tostring(device.builtIn) .. device.name)
    end
    for network in machine.networks do
      -- A strength is said in thirds, as it is drawn: every network's
      -- strength wavers by the second, and the list must not.
      local strength = tostring(network.signal >= 66) .. tostring(
        network.signal >= 33
      )
      Table.insert(
        parts,
        network.name .. strength .. tostring(network.secured) .. tostring(
          network.known
        )
      )
    end
    return String.join("|", parts)
  end

  -- Every keyboard layout as {code, name}, by name.
  fn layouts() -> table<table<string>>
    if self.layoutList == nil then
      self.layoutList = self.asked(fn(wm: WmSettings) -> table<string>
        return wm.layouts()
      end)
    end
    local out: table<table<string>> = {}
    for line in self.layoutList! do
      local fields = String.split(line, "\t")
      if #fields >= 2 then
        Table.insert(out, {fields[1], fields[2]})
      end
    end
    return out
  end

  -- What the layout `code` is called: "Lithuanian".
  fn layoutName(code: string) -> string
    local base = String.split(code, "(")[1]
    for layout in self.layouts() do
      if layout[1] == base then
        return layout[2]
      end
    end
    return code
  end

  -- Every time zone as {id, city, region}.
  fn zones() -> table<table<string>>
    if self.zoneList == nil then
      self.zoneList = self.asked(fn(wm: WmSettings) -> table<string>
        return wm.zones()
      end)
    end
    local out: table<table<string>> = {}
    for line in self.zoneList! do
      local fields = String.split(line, "\t")
      if #fields >= 3 then
        Table.insert(out, {fields[1], fields[2], fields[3]})
      end
    end
    return out
  end

  local fn asked(ask: fn(WmSettings) -> table<string>) -> table<string>
    local wm = self.wm
    if wm == nil then
      return {}
    end
    try
      return ask(wm!)
    catch e: string
      self.lose(e)
      return {}
    end
  end

  -- Ask the window manager for something of the computer's, and then
  -- how the computer stands, so what is shown is what was done.
  fn tell(what: fn(WmSettings) -> nil) -> nil
    local wm = self.wm
    if wm == nil then
      return
    end
    try
      what(wm!)
      self.machine = wm!.machine()
    catch e: string
      self.lose(e)
    end
  end

  local fn lose(problem: string) -> nil
    SystemSettings.log.warn("window manager unreachable", {reason: problem})
    self.wm = nil
    self.recording = false
    self.problem = problem
  end
end
