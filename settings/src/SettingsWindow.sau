-- The Settings window: the sidebar of panes, and the pane that is open
-- beside it.
--
-- A change to the window manager's own settings goes one way: a pane
-- edits them, calls `changed`, and that sends them to the window manager
-- and builds the window again from what it answered — so what is shown
-- is always what the window manager is using.
--
-- The computer itself (its sound, network, devices) changes from outside
-- too: a key turns the volume, a mouse is plugged in. So the window asks
-- how it stands every second, and builds again when anything it shows
-- changed; a pane whose device has gone gives way to the first one.

from uikit import *
from "wmapi" import Presets
from model import Pane, SystemSettings
from theme import Style
from views import PaneIcon, Sidebar
from panes import AboutPane, AppearancePane, KeyboardPane, MousePane
from panes import StoragePane
from panes import OfflinePane
from panes import WallpaperPane
from panes import WindowsPane
from panes import DateTimePane, DisplaysPane, GeneralPane, NetworkPane
from panes import BluetoothPane, PasswordPane, SoundPane, TrackpadPane
from panes import UpdatePane
from panes import WifiPane

export class SettingsWindow extends View
  settings: SystemSettings

  -- The pane open at first, by its place among all of them
  -- (`Sidebar.every`).
  first: integer

  -- How often the computer is asked about again, in seconds.
  static every: float = 1.0

  fn init(settings: SystemSettings, first: integer = 0, key: string? = nil)
    self.super(key)
    self.settings = settings
    self.first = first
  end

  -- The place of the pane called `name` ("storage", "Wallpaper", "wi-fi";
  -- its first word will do), or 0 when there is no such pane: then the
  -- first one the sidebar lists is opened.
  static fn place(name: string) -> integer
    local wanted = String.lower(name)
    if wanted == "" then
      return 0
    end
    local panes = Sidebar.every()
    for i = 1, #panes do
      local title = String.lower(panes[i].title())
      if title == wanted or String.split(title, " ")[1] == wanted then
        return i
      end
    end
    return 0
  end

  -- It has a tick to run: see `View.ticks`.
  fn ticks() -> boolean
    return true
  end

  fn tick(el: Element, dt: float) -> nil
    local bag: table = el.data.scratch
    -- The window can be tiled into a third of the screen at any moment:
    -- narrow, the sidebar gives its names' room to the pane.
    local narrow = el.size.width > 0.0 and el.size.width < Style.narrowBelow
    if narrow != ((bag.narrow as boolean?) ?? false) then
      bag.narrow = narrow
      el.markNeedsBuild()
    end
    local waited = ((bag.waited as float?) ?? 0.0) + dt
    if waited < SettingsWindow.every then
      bag.waited = waited
      return
    end
    bag.waited = 0.0
    if self.settings.refreshMachine() then
      el.markNeedsBuild()
    end
  end

  fn body(context: BuildContext) -> View
    local settings = self.settings
    local machine = settings.machine
    local panes = Sidebar.every()
    local revision = context.state("revision", 0)
    local opened = context.state("pane", self.first)

    -- The pane asked for, if the computer has what it is about; else
    -- the first the sidebar lists.
    local groups = Sidebar.shown(machine)
    local open = groups[1][1]
    local asked = panes[opened.int(self.first)]
    if asked != nil and Sidebar.has(asked!, machine) then
      open = asked!
    end

    local refresh = fn()
      revision.set(revision.int(0) + 1)
    end
    local changed = fn()
      settings.apply()
      refresh()
    end
    local openPane = fn(pane: Pane)
      -- A shortcut half recorded is dropped with its pane.
      settings.recordKeys(false)
      for i = 1, #panes do
        if panes[i] == pane then
          opened.set(i)
        end
      end
      -- About shows the system as it is now, not as it was at launch.
      if pane == Pane.About or pane == Pane.Displays then
        settings.refreshInfo()
      end
      if pane == Pane.Storage then
        settings.refreshStorage()
      end
    end

    local pane = self.pane(open, changed, refresh, openPane)
    local parent = open.parent()
    if parent != nil then
      pane = VStack(alignment: StackAlignment.Fill, spacing: 10.0) do
        SettingsWindow.back(parent!, openPane)
        pane.expanded()
      end
    end
    if not settings.connected() then
      pane = OfflinePane(settings, refresh)
    end

    local accent = Presets.find(Presets.accents, settings.options.accent)
    local narrow = (context.data().scratch.narrow as boolean?) ?? false
    local sidebarWidth = Style.sidebarWidth
    local padding = Style.padding
    if narrow then
      sidebarWidth = Style.sidebarIcons
      padding = Style.padding / 2.0
    end
    local layout = HStack(alignment: StackAlignment.Fill) do
      Sidebar(open, machine, openPane, narrow).frame(width: sidebarWidth)
      pane.padding(padding).expanded()
    end
    return Theme(
      data: Style.theme(Style.colour(accent.colours[1])),
      child: layout.background(Style.window)
    )
  end

  -- The way back from a pane another opened: "‹ General".
  static fn back(parent: Pane, openPane: ValueChanged<Pane>) -> View
    local label = Text("‹  " .. parent.title()).font(13.0)
    local go = fn()
      openPane(parent)
    end
    local link = GestureArea(
      child: label.foregroundStyle(Style.dimText),
      onTap: go
    )
    return HStack(alignment: StackAlignment.Center) do
      show(link)
      Spacer()
    end
  end

  -- The view of the pane `open`.
  local fn pane(
    open: Pane,
    changed: Action,
    refresh: Action,
    openPane: ValueChanged<Pane>
  ) -> View
    local settings = self.settings
    local pane: View = AboutPane(settings)
    match open
      case Pane.Wifi then
        pane = WifiPane(settings, refresh)
      case Pane.Bluetooth then
        pane = BluetoothPane(settings, refresh)
      case Pane.Network then
        pane = NetworkPane(settings)
      case Pane.Sound then
        pane = SoundPane(settings, refresh)
      case Pane.General then
        pane = GeneralPane(settings, refresh, openPane)
      case Pane.Displays then
        pane = DisplaysPane(settings, refresh, changed)
      case Pane.Appearance then
        pane = AppearancePane(settings, changed)
      case Pane.Windows then
        pane = WindowsPane(settings, changed)
      case Pane.Wallpaper then
        pane = WallpaperPane(settings, changed)
      case Pane.Password then
        pane = PasswordPane(settings, refresh)
      case Pane.Keyboard then
        pane = KeyboardPane(settings, changed)
      case Pane.Mouse then
        pane = MousePane(settings, changed)
      case Pane.Trackpad then
        pane = TrackpadPane(settings, changed)
      case Pane.Storage then
        pane = StoragePane(settings)
      case Pane.DateTime then
        pane = DateTimePane(settings, refresh)
      case Pane.Update then
        pane = UpdatePane(settings, refresh)
      case Pane.About then nil
    end
    return pane
  end
end
