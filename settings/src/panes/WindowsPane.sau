-- How windows are tiled: the gaps between them, how they resize, and
-- where a new one goes.

from uikit import *
from model import SystemSettings
from theme import Style
from views import Group, PaneTitle, Row, Said, Segmented, SliderControl

export class WindowsPane extends View
  settings: SystemSettings
  changed: Action

  fn init(settings: SystemSettings, changed: Action, key: string? = nil)
    self.super(key)
    self.settings = settings
    self.changed = changed
  end

  fn body(context: BuildContext) -> View
    local options = self.settings.options
    local changed = self.changed

    local gap = SliderControl(options.gap, 0.0, 24.0, 1.0, " px", fn(v: float)
      options.gap = v
      changed()
    end)
    local grab = SliderControl(
      options.grab,
      0.0,
      12.0,
      1.0,
      " px",
      fn(v: float)
        options.grab = v
        changed()
      end
    )
    local step = options.resizeStep as float
    local resize = SliderControl(step, 1.0, 50.0, 1.0, "", fn(v: float)
      options.resizeStep = Math.floor(v + 0.5)
      changed()
    end)
    local where = Segmented(
      {"beside", "below"},
      {"Beside", "Below"},
      options.newWindows,
      fn(choice: string)
        options.newWindows = choice
        changed()
      end
    )

    local mode = "tiled"
    if options.windowed then
      mode = "windowed"
    end
    local arrange = Segmented(
      {"tiled", "windowed"},
      {"Tiled", "Windowed"},
      mode,
      fn(choice: string)
        options.windowed = choice == "windowed"
        changed()
      end
    )
    local dock = Toggle(value: options.dock, onChanged: fn(on: boolean)
      options.dock = on
      changed()
    end)
    local keys = self.settings.shortcut("windowed")
    local hint = "Tiled windows share the screen without overlapping. Windowed mode lets windows be moved, resized and overlapped."
    if #keys > 0 then
      hint = hint .. " Press " .. String.upper(String.join("+", keys)) .. " to switch."
    end

    -- In a pane that scrolls: taller than a netbook's screen leaves it.
    return Said.pane({
      PaneTitle("Desktop & Windows"),
      Group("Windows", {Row("Window arrangement", arrange), Row("Show Dock", dock)}),
      WindowsPane.note(hint),
      Group("Tiling", {
        Row("Window gap", gap),
        Row("Resize handle width", grab),
        Row("Resize step", resize),
      }),
      Group("New Windows", {Row("Placement", where)}),
    })
  end

  -- Words under a group.
  static fn note(words: string) -> View
    local text = Text(words).font(11.0).foregroundStyle(Style.dimText)
    return text.lineLimit(3).padding(insets: EdgeInsets.only(left: 4.0, right: 4.0))
  end
end
