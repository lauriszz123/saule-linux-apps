-- Storage, as the Mac's: each disk with its picture, how much of it is
-- available, and a bar of what its used space holds; then what each kind
-- of thing takes, where settings are kept, and what the main drive is.

from uikit import *
from "wmapi" import StorageCategory, StorageReport, StorageVolume
from model import SystemSettings
from theme import Style
from views import DriveIcon, Group, PaneTitle, Row, StorageBar

export class StoragePane extends View
  settings: SystemSettings

  fn init(settings: SystemSettings, key: string? = nil)
    self.super(key)
    self.settings = settings
  end

  -- How often the disks are asked about again, in seconds. Not every
  -- second: the window manager counts files to answer.
  static every: float = 3.0

  -- It has a tick to run: see `View.ticks`.
  fn ticks() -> boolean
    return true
  end

  -- Ask again every `every` seconds, and build the pane again when a
  -- number in it changed.
  fn tick(el: Element, dt: float) -> nil
    local bag: table = el.data.scratch
    local waited = ((bag.waited as float?) ?? 0.0) + dt
    if waited < StoragePane.every then
      bag.waited = waited
      return
    end
    bag.waited = 0.0

    local before = StoragePane.said(self.settings.storage)
    self.settings.refreshStorage()
    if StoragePane.said(self.settings.storage) != before then
      el.markNeedsBuild()
    end
  end

  -- Every number the pane shows of `report`, to tell when one changed.
  static fn said(report: StorageReport) -> string
    local values: table<string> = {tostring(report.persistent)}
    for volume in report.volumes do
      Table.insert(
        values,
        volume.mount .. " " .. volume.used .. " " .. volume.free
      )
    end
    for category in report.categories do
      Table.insert(values, category.name .. " " .. category.bytes)
    end
    return String.join("\n", values)
  end

  fn body(context: BuildContext) -> View
    local report = self.settings.storage
    local items: table<View> = {PaneTitle("Storage")}
    if #report.volumes == 0 then
      local none = Text("No disks were found.").font(13.0).foregroundStyle(
        Style.dimText
      )
      Table.insert(items, none)
    end
    for volume in report.volumes do
      Table.insert(items, StoragePane.card(report, volume))
    end
    if #report.volumes > 0 then
      Table.insert(items, StoragePane.kept(report))
      Table.insert(items, StoragePane.kinds(report))
      Table.insert(items, StoragePane.drive(report.volumes[1]))
    end
    local fill = StackAlignment.Fill
    local column = VStack(alignment: fill, spacing: 18.0, children: items)
    local inset = EdgeInsets.only(left: 4.0, top: 4.0, right: 8.0, bottom: 8.0)
    return ScrollView(child: column.padding(insets: inset))
  end

  -- One volume: its picture and name, how much is available, and the bar
  -- of what it holds with the legend under it.
  static fn card(report: StorageReport, volume: StorageVolume) -> View
    local size = volume.driveBytes
    if size <= 0 then
      size = volume.total
    end
    local name = Text(volume.name).font(15.0).foregroundStyle(Style.text)
    local free = StorageReport.bytes(volume.free) .. " available of " .. StorageReport.bytes(
      volume.total
    )
    local available = Text(free).font(12.0).foregroundStyle(Style.dimText)
    local about: table<string> = {}
    if volume.model != "" then
      Table.insert(about, volume.model)
    end
    if volume.kind != "memory" then
      Table.insert(
        about,
        StorageReport.bytes(size) .. " " .. StorageReport.kindName(volume.kind)
      )
    end
    local described = Text(String.join(" · ", about)).font(11.0).foregroundStyle(
      Style.dimText
    )

    local lead = StackAlignment.Leading
    local words = VStack(
      alignment: lead,
      spacing: 3.0,
      children: {name, available, described}
    )
    local icon = DriveIcon(volume.kind).frame(width: 52.0, height: 52.0)
    local head = HStack(
      alignment: StackAlignment.Center,
      spacing: 14.0,
      children: {icon, words}
    )

    -- The bar: each kind of thing on this volume, then the rest of what
    -- is used.
    local sizes: table<integer> = {}
    local colours: table<Color> = {}
    local legend: table<View> = {}
    local counted = 0
    for category in report.categories do
      if category.volume == volume.mount and category.bytes > 0 then
        Table.insert(sizes, category.bytes)
        Table.insert(colours, StoragePane.colour(category.name))
        Table.insert(legend, StoragePane.key(category.name))
        counted += category.bytes
      end
    end
    local other = volume.used - counted
    if other > 0 then
      Table.insert(sizes, other)
      Table.insert(colours, StoragePane.colour("Other"))
      Table.insert(legend, StoragePane.key("Other"))
    end
    local bar = StorageBar(sizes, colours, volume.total).frame(height: 16.0)

    local fill = StackAlignment.Fill
    local center = StackAlignment.Center
    local keys = HStack(alignment: center, spacing: 16.0, children: legend)
    local items: table<View> = {head, bar, keys}
    local inside = VStack(alignment: fill, spacing: 12.0, children: items)
    return inside.padding(insets: EdgeInsets.all(14.0)).background(
      Style.card,
      Style.cardRadius
    )
  end

  -- A legend entry: the colour's dot and the name.
  static fn key(name: string) -> View
    local dot = Spacer().frame(width: 8.0, height: 8.0).background(
      StoragePane.colour(name),
      4.0
    )
    local label = Text(name).font(11.0).foregroundStyle(Style.dimText)
    return HStack(
      alignment: StackAlignment.Center,
      spacing: 5.0,
      children: {dot, label}
    )
  end

  -- Whether settings outlive a restart, and where they are kept.
  static fn kept(report: StorageReport) -> View
    local said = "Kept on " .. report.volumes[1].name .. ": they stay after a restart"
    local colour = Style.dimText
    if not report.persistent then
      said = "In memory only: lost when the computer turns off"
      colour = Style.warning
    end
    local value = Text(said).font(12.0).foregroundStyle(colour)
    return Group("Settings", {Row("Your settings", value)})
  end

  -- What each kind of thing takes up, biggest first, as the Mac's list.
  static fn kinds(report: StorageReport) -> View
    local categories: table<StorageCategory> = Table.copy(report.categories)
    Table.sort(
      categories,
      fn(a: StorageCategory, b: StorageCategory) -> boolean
        return a.bytes > b.bytes
      end
    )
    local rows: table<View> = {}
    for category in categories do
      Table.insert(rows, StoragePane.kind(report, category))
    end
    if #rows == 0 then
      local none = Text("Nothing counted").font(13.0).foregroundStyle(
        Style.dimText
      )
      Table.insert(rows, Row("Used", none))
    end
    return Group("Used by", rows)
  end

  -- One kind: its colour as an icon, its name and the volume it is on,
  -- and its size on the right.
  static fn kind(report: StorageReport, category: StorageCategory) -> View
    local swatch = Spacer().frame(width: 22.0, height: 22.0).background(
      StoragePane.colour(category.name),
      6.0
    )
    local where = ""
    for volume in report.volumes do
      if volume.mount == category.volume then
        where = volume.name
      end
    end
    local name = Text(category.name).font(13.0).foregroundStyle(Style.text)
    local on = Text("On " .. where).font(11.0).foregroundStyle(Style.dimText)
    local lead = StackAlignment.Leading
    local words = VStack(alignment: lead, spacing: 1.0, children: {name, on})
    local size = Text(StorageReport.bytes(category.bytes)).font(13.0).foregroundStyle(
      Style.dimText
    )
    local center = StackAlignment.Center
    local line = HStack(
      alignment: center,
      spacing: 10.0,
      children: {swatch, words, Spacer(), size}
    )
    local inset = EdgeInsets.only(
      left: 14.0,
      top: 7.0,
      right: 14.0,
      bottom: 7.0
    )
    return line.padding(insets: inset)
  end

  -- What the main drive is.
  static fn drive(volume: StorageVolume) -> View
    local size = volume.driveBytes
    if size <= 0 then
      size = volume.total
    end
    local speed = ""
    if volume.rpm > 0 then
      speed = volume.rpm .. " rpm"
    end
    local rows: table<View> = {
      StoragePane.fact("Name", volume.name),
      StoragePane.fact("Drive", volume.model),
      StoragePane.fact("Kind", StoragePane.kindTitle(volume.kind)),
      StoragePane.fact("Capacity", StorageReport.bytes(size)),
      StoragePane.fact("Spins at", speed),
      StoragePane.fact("Connection", volume.connection),
      StoragePane.fact("Serial number", volume.serial),
      StoragePane.fact("Volume size", StorageReport.bytes(volume.total)),
      StoragePane.fact("Used", StorageReport.bytes(volume.used)),
      StoragePane.fact("Available", StorageReport.bytes(volume.free)),
      StoragePane.fact("File system", volume.fileSystem),
      StoragePane.fact("Device", volume.device),
      StoragePane.fact("Mounted at", volume.mount),
    }
    return Group("Drive", rows)
  end

  static fn fact(label: string, value: string) -> View
    local shown = value
    if shown == "" then
      shown = "—"
    end
    return Row(label, Text(shown).font(13.0).foregroundStyle(Style.dimText))
  end

  static fn kindTitle(kind: string) -> string
    return match kind
      case "hdd" then "Hard disk"
      case "ssd" then "Solid-state drive"
      case "usb" then "USB drive"
      case "memory" then "Memory"
      case _ then "Disk"
    end
  end

  -- Each kind's colour, the Mac's where it has one: apps red, documents
  -- (the home) orange, photos (wallpapers) yellow, the system grey.
  static fn colour(name: string) -> Color
    return match name
      case "Apps" then Color(0.98, 0.33, 0.30)
      case "Home" then Color(1.0, 0.62, 0.04)
      case "Settings" then Color(0.25, 0.52, 0.96)
      case "Wallpapers" then Color(1.0, 0.80, 0.04)
      case "System" then Color(0.56, 0.56, 0.60)
      case _ then Color(0.78, 0.78, 0.80)
    end
  end
end
