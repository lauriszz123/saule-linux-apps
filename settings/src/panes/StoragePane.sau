-- Storage, laid out as the Mac's: each volume as its name, how much of it
-- is used, and one bar coloured by what uses it, with the colours named
-- under it; then the kinds of thing as a list, each with its icon and its
-- size; and last what the drive itself is.
--
-- Saule Linux has two places things are: the disk, where settings and
-- documents are kept, and the memory the system itself runs from. Each is
-- a volume here, the disk first.

from uikit import *
from "wmapi" import StorageCategory, StorageReport, StorageVolume
from model import SystemSettings
from theme import Style
from views import CategoryIcon, Group, PaneTitle, Row, StorageBar

export class StoragePane extends View
  settings: SystemSettings

  -- How often the disks are asked about again, in seconds. Not every
  -- second: the window manager counts files to answer.
  static every: float = 3.0

  -- The kinds listed, in the order a Mac lists its own: what is the
  -- person's first, then the system's.
  static mine: table<string> = {
    "Applications",
    "Documents",
    "Wallpapers",
    "Settings",
  }
  static system: table<string> = {"Saule Linux", "Other"}

  fn init(settings: SystemSettings, key: string? = nil)
    self.super(key)
    self.settings = settings
  end

  -- It has a tick to run: see `View.ticks`.
  fn ticks() -> boolean
    return true
  end

  -- Ask at once, then again every `every` seconds, and build the pane
  -- again when a number in it changed.
  fn tick(el: Element, dt: float) -> nil
    local bag: table = el.data.scratch
    local waited = ((bag.waited as float?) ?? StoragePane.every) + dt
    if waited < StoragePane.every then
      bag.waited = waited
      return
    end
    bag.waited = 0.0

    local before = StoragePane.said(self.settings.storage)
    self.settings.refreshStorage()
    if StoragePane.said(self.settings.storage) != before then
      el.markNeedsBuild()
    end
  end

  -- Every number the pane shows of `report`, to tell when one changed.
  static fn said(report: StorageReport) -> string
    local values: table<string> = {tostring(report.persistent)}
    for volume in report.volumes do
      Table.insert(
        values,
        volume.mount .. " " .. volume.used .. " " .. volume.free
      )
    end
    for category in report.categories do
      Table.insert(values, category.name .. " " .. category.bytes)
    end
    return String.join("\n", values)
  end

  fn body(context: BuildContext) -> View
    local report = self.settings.storage
    local items: table<View> = {PaneTitle("Storage")}
    for volume in report.volumes do
      Table.insert(items, StoragePane.volume(report, volume))
    end
    if #report.volumes > 0 then
      local mine = StoragePane.kinds(report, StoragePane.mine)
      local system = StoragePane.kinds(report, StoragePane.system)
      if mine != nil then
        Table.insert(items, mine!)
      end
      if system != nil then
        Table.insert(items, system!)
      end
      Table.insert(items, StoragePane.drive(report.volumes[1]))
    end

    local fill = StackAlignment.Fill
    local column = VStack(alignment: fill, spacing: 20.0, children: items)
    local inset = EdgeInsets.only(left: 4.0, top: 4.0, right: 8.0, bottom: 12.0)
    return ScrollView(child: column.padding(insets: inset))
  end

  -- One volume: its name and how much of it is used, the bar of what uses
  -- it with the colours named under it, and a line about it below.
  static fn volume(report: StorageReport, volume: StorageVolume) -> View
    local used = StorageReport.bytes(volume.total - volume.free)
    local name = Text(volume.name).font(15.0).foregroundStyle(Style.text)
    local amount = Text(
      used .. " of " .. StorageReport.bytes(volume.total) .. " used"
    )
    local center = StackAlignment.Center
    local head = HStack(
      alignment: center,
      children: {
        name,
        Spacer(),
        amount.font(13.0).foregroundStyle(Style.dimText),
      }
    )

    -- Each kind of thing on this volume, then the rest of what is used.
    local sizes: table<integer> = {}
    local colours: table<Color> = {}
    local legend: table<View> = {}
    for category in StoragePane.on(report, volume) do
      if category.bytes > 0 then
        Table.insert(sizes, category.bytes)
        Table.insert(colours, CategoryIcon.colour(category.name))
        Table.insert(legend, StoragePane.key(category.name))
      end
    end
    local bar = StorageBar(sizes, colours, volume.total).frame(height: 22.0)

    local free = Text(StorageReport.bytes(volume.free) .. " available")
    Table.insert(legend, Spacer())
    Table.insert(legend, free.font(11.0).foregroundStyle(Style.dimText))
    local foot = HStack(alignment: center, spacing: 14.0, children: legend)

    local fill = StackAlignment.Fill
    local inside = VStack(
      alignment: fill,
      spacing: 12.0,
      children: {head, bar, foot}
    )
    local card = inside.padding(insets: EdgeInsets.all(16.0)).background(
      Style.card,
      Style.cardRadius
    )

    local colour = Style.dimText
    local about = StoragePane.about(report, volume)
    if volume.kind == "memory" and not report.persistent then
      colour = Style.warning
    end
    local note = Text(about).font(11.0).foregroundStyle(colour).lineLimit(2)
    local under = note.padding(insets: EdgeInsets.only(left: 4.0, right: 4.0))
    return VStack(alignment: fill, spacing: 8.0, children: {card, under})
  end

  -- What is said under a volume: the drive it is on, and what it is for.
  static fn about(report: StorageReport, volume: StorageVolume) -> string
    if volume.kind == "memory" then
      if report.persistent then
        return "The system itself, which runs from memory."
      end
      return "The system runs from memory, and there is no disk to keep" .. " things on: settings last until the computer turns off."
    end
    local size = volume.driveBytes
    if size <= 0 then
      size = volume.total
    end
    local drive = StorageReport.bytes(size) .. " " .. StorageReport.kindName(
      volume.kind
    )
    if volume.model != "" then
      drive = volume.model .. " · " .. drive
    end
    if volume.main and report.persistent then
      return drive .. ". Settings and documents are kept here."
    end
    return drive
  end

  -- The kinds of thing on `volume`, and "Other": what else it holds.
  static fn on(report: StorageReport, volume: StorageVolume) -> table<StorageCategory>
    local found: table<StorageCategory> = {}
    local counted = 0
    for category in report.categories do
      if category.volume == volume.mount then
        Table.insert(found, category)
        counted += category.bytes
      end
    end
    local other = StorageCategory()
    other.name = "Other"
    other.volume = volume.mount
    -- All that isn't available: what the file system keeps for itself is
    -- of no more use to anyone than a file would be.
    other.bytes = Math.max(volume.total - volume.free - counted, 0)
    if other.bytes > 0 then
      Table.insert(found, other)
    end
    return found
  end

  -- A colour's name under the bar: its dot and the kind it stands for.
  static fn key(name: string) -> View
    local dot = Spacer().frame(width: 8.0, height: 8.0).background(
      CategoryIcon.colour(name),
      4.0
    )
    local label = Text(name).font(11.0).foregroundStyle(Style.dimText)
    return HStack(
      alignment: StackAlignment.Center,
      spacing: 5.0,
      children: {dot, label}
    )
  end

  -- The kinds named in `names`, as a list: each with its icon and what it
  -- takes up. Nil when the system has none of them.
  static fn kinds(report: StorageReport, names: table<string>) -> View?
    local all: table<StorageCategory> = {}
    for volume in report.volumes do
      for category in StoragePane.on(report, volume) do
        Table.insert(all, category)
      end
    end
    local rows: table<View> = {}
    for name in names do
      local bytes = 0
      local found = false
      for category in all do
        if category.name == name then
          bytes += category.bytes
          found = true
        end
      end
      if found then
        if #rows > 0 then
          Table.insert(rows, StoragePane.hairline())
        end
        Table.insert(rows, StoragePane.kind(name, bytes))
      end
    end
    if #rows == 0 then
      return nil
    end
    local list = VStack(alignment: StackAlignment.Fill, children: rows)
    return list.background(Style.card, Style.cardRadius)
  end

  -- One kind: its icon and name, and its size on the right.
  static fn kind(name: string, bytes: integer) -> View
    local icon = CategoryIcon(name).frame(width: 26.0, height: 26.0)
    local label = Text(name).font(13.0).foregroundStyle(Style.text)
    local size = Text(StoragePane.amount(bytes)).font(13.0)
    local line = HStack(
      alignment: StackAlignment.Center,
      spacing: 12.0,
      children: {icon, label, Spacer(), size.foregroundStyle(Style.dimText)}
    )
    local inset = EdgeInsets.symmetric(horizontal: 14.0, vertical: 9.0)
    return line.padding(insets: inset)
  end

  -- Between two kinds, starting where their names do.
  static fn hairline() -> View
    local line = Spacer().frame(height: 1.0).background(Style.hairline)
    return line.padding(insets: EdgeInsets.only(left: 52.0))
  end

  -- A size as the list says it: nothing at all is "Zero KB", as on a Mac.
  static fn amount(bytes: integer) -> string
    if bytes <= 0 then
      return "Zero KB"
    end
    return StorageReport.bytes(bytes)
  end

  -- What the main drive is: only what it says of itself.
  static fn drive(volume: StorageVolume) -> View
    local size = volume.driveBytes
    if size <= 0 then
      size = volume.total
    end
    local kind = StoragePane.kindTitle(volume.kind)
    if volume.rpm > 0 then
      kind = kind .. ", " .. volume.rpm .. " rpm"
    end
    local facts: table<table<string>> = {
      {"Model", volume.model},
      {"Kind", kind},
      {"Capacity", StorageReport.bytes(size)},
      {"Connection", volume.connection},
      {"Format", volume.fileSystem},
      {"Serial number", volume.serial},
      {"Device", volume.device},
    }
    local rows: table<View> = {}
    for fact in facts do
      if fact[2] != "" then
        local value = Text(fact[2]).font(13.0).foregroundStyle(Style.dimText)
        Table.insert(rows, Row(fact[1], value))
      end
    end
    return Group("Drive", rows)
  end

  static fn kindTitle(kind: string) -> string
    return match kind
      case "hdd" then "Hard disk"
      case "ssd" then "Solid-state drive"
      case "usb" then "USB drive"
      case "memory" then "Memory"
      case _ then "Disk"
    end
  end
end
