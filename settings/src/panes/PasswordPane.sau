-- Who the computer is for, and the password asked for when it starts
-- and when its screen is unlocked.
--
-- Changing the password takes the one there is: the system checks it,
-- since nothing else can read what is kept of one, and says how it went
-- a moment later (`MachineInfo.passwordChange`). With no password the
-- computer starts straight to the desktop, and locking it keeps out a
-- glance, not a person.

from uikit import *
from "wmapi" import WmSettings
from model import SystemSettings
from theme import Style
from views import Field, Group, PaneTitle, Row, Said

export class PasswordPane extends View
  settings: SystemSettings
  refresh: Action

  fn init(settings: SystemSettings, refresh: Action, key: string? = nil)
    self.super(key)
    self.settings = settings
    self.refresh = refresh
  end

  fn body(context: BuildContext) -> View
    local settings = self.settings
    local machine = settings.machine
    local refresh = self.refresh
    local person = context.state("person", "")
    local naming = context.state("naming", 0)
    local old = context.state("old", "")
    local new = context.state("new", "")
    local again = context.state("again", "")
    -- How many changes the system had answered when one was last asked
    -- for here, or -1: its answer is shown once it has answered another.
    local asked = context.state("asked", -1)

    local name = machine.person
    if naming.int(0) == 1 then
      name = person.text("")
    end
    local nameField = Field(name, "Full name", fn(text: string)
      person.set(text)
      naming.set(1)
    end, fn(text: string)
      settings.tell(fn(wm: WmSettings)
        wm.setPerson(text)
      end)
      naming.set(0)
      refresh()
    end)
    local items: table<View> = {
      PaneTitle("Login Password"),
    }
    -- The account's short name is what the home folder is called: shown,
    -- not changed here, since everything kept is filed under it.
    local who: table<View> = {Row("Full name", nameField)}
    if machine.account != "" then
      Table.insert(who, Row("Account name", Said(machine.account)))
    end
    Table.insert(items, Group("Account", who))

    local hidden = fn(binding: Binding, placeholder: string) -> View
      return Field(binding.text(""), placeholder, fn(text: string)
        binding.set(text)
      end, hidden: true)
    end
    local rows: table<View> = {}
    if machine.hasPassword then
      Table.insert(rows, Row("Current password", hidden(old, "Current")))
    end
    Table.insert(rows, Row("New password", hidden(new, "New")))
    Table.insert(rows, Row("Verify", hidden(again, "Again")))

    local change = fn(word: string)
      asked.set(machine.passwordChanges)
      settings.tell(fn(wm: WmSettings)
        wm.setPassword(old.text(""), word)
      end)
      old.set("")
      new.set("")
      again.set("")
      refresh()
    end
    local typed = String.trim(new.text(""))
    local same = typed != "" and typed == String.trim(again.text(""))
    local title = "Set Password"
    if machine.hasPassword then
      title = "Change Password"
    end
    local buttons: table<View> = {Spacer()}
    if machine.hasPassword then
      -- Not in the accent: it is not what the pane is mostly for.
      local off = Button(
        label: "Turn Off Password",
        color: Style.segment,
        onPressed: fn()
          change("")
        end
      )
      Table.insert(buttons, off)
    end
    Table.insert(
      buttons,
      Button(label: title, enabled: same, onPressed: fn()
        change(typed)
      end)
    )
    local heading = "Password"
    Table.insert(items, Group(heading, rows))
    Table.insert(
      items,
      HStack(
        alignment: StackAlignment.Center,
        spacing: 8.0,
        children: buttons
      )
    )

    local said = PasswordPane.said(machine.hasPassword)
    local warning = false
    if typed != "" and String.trim(again.text("")) != "" and not same then
      said = "The passwords do not match."
      warning = true
    elseif asked.int(-1) >= 0 and machine.passwordChanges > asked.int(-1) then
      match machine.passwordChange
        case "done" then
          said = "Done. " .. PasswordPane.said(machine.hasPassword)
        case "wrong" then
          said = "The current password is incorrect. No changes were made."
          warning = true
        case _ then
          said = "The password could not be saved. No changes were made."
          warning = true
      end
    elseif asked.int(-1) >= 0 then
      said = "Checking…"
    end
    Table.insert(items, Said.note(said, warning: warning))
    return Said.pane(items)
  end

  static fn said(hasPassword: boolean) -> string
    if hasPassword then
      return "The password is required at startup and to unlock the screen."
    end
    return "No password is set. The computer starts directly to the desktop."
  end
end
