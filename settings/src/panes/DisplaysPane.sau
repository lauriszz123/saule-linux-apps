-- The screen: how many points it shows, what draws it, and how bright
-- its backlight is on a computer that has one to set (a laptop; not a
-- desktop's monitor, which has buttons of its own).

from uikit import *
from "wmapi" import WmSettings
from model import SystemSettings
from theme import Style
from views import Group, PaneTitle, Row, Said, Segmented, SliderControl

export class DisplaysPane extends View
  settings: SystemSettings
  refresh: Action
  -- Send the window manager's own settings: the size is one of them.
  changed: Action

  fn init(
    settings: SystemSettings,
    refresh: Action,
    changed: Action,
    key: string? = nil
  )
    self.super(key)
    self.settings = settings
    self.refresh = refresh
    self.changed = changed
  end

  fn body(context: BuildContext) -> View
    local settings = self.settings
    local machine = settings.machine
    local info = settings.info
    local refresh = self.refresh

    local rows: table<View> = {}
    if info.screenWidth > 0 then
      local size = info.screenWidth .. " × " .. info.screenHeight
      Table.insert(rows, Row("Resolution", Said(size)))
    end
    -- With the chips listed below, their names are not said twice.
    if info.graphics != "" and #info.cards == 0 then
      Table.insert(rows, Row("Graphics", Said(info.graphics)))
    end

    local items: table<View> = {PaneTitle("Displays"), Group("Display", rows)}

    -- Every graphics chip the system lists, and what the screen is drawn
    -- by: on every system, so a problem shows wherever it is met, in a
    -- window on a desktop as on Saule Linux's own screen.
    local chips: table<View> = {}
    for card in info.cards do
      local said = "No driver available"
      if card.driver != "" and card.primary then
        said = "In use"
      elseif card.driver != "" then
        said = "Available"
      elseif card.primary then
        said = "In use, without a dedicated driver"
      end
      Table.insert(chips, Row(card.name, Said(said)))
    end
    local drawn = "Software (processor)"
    if info.renderer != "" then
      drawn = info.renderer
    end
    Table.insert(chips, Row("Renderer", Said(drawn)))
    Table.insert(items, Group("Graphics", chips))
    if info.renderer == "" then
      Table.insert(
        items,
        Said.note(
          "Graphics acceleration is unavailable. Rendering may be slower.",
          warning: true
        )
      )
      local why = info.rendererProblem
      if why == "" then
        why = "No compatible graphics driver was found."
      end
      Table.insert(items, Said.note("Reason: " .. why))
    end

    -- How large everything is drawn: on Saule Linux's own screen. Nested
    -- in another desktop, that desktop decides.
    if machine.managed and settings.info.host == "saule" then
      local options = settings.options
      local chosen = String.format("%.2f", options.scale)
      local changed = self.changed
      local size = Segmented(
        {"0.00", "1.00", "1.25", "1.50", "1.75", "2.00"},
        {"Auto", "100%", "125%", "150%", "175%", "200%"},
        chosen,
        fn(choice: string)
          options.scale = (choice as float?) ?? 0.0
          changed()
        end
      )
      Table.insert(items, Group("Scaling", {Row("Display scale", size)}))
      Table.insert(
        items,
        Said.note(
          "Auto selects a scale based on the display's resolution."
        )
      )
    end
    if machine.backlight then
      local brightness = SliderControl(
        machine.brightness as float,
        0.0,
        100.0,
        1.0,
        "%",
        fn(v: float)
          settings.tell(fn(wm: WmSettings)
            wm.setBrightness(v as integer)
          end)
          refresh()
        end
      )
      Table.insert(items, Group("Brightness", {Row("Brightness", brightness)}))
      Table.insert(
        items,
        Said.note(
          "Brightness can also be adjusted with the keyboard's brightness keys."
        )
      )
    end

    -- Left alone: when the screen dims, and when it locks. On Saule
    -- Linux's own screen; nested, the other desktop does its own.
    if machine.managed and settings.info.host == "saule" then
      local options = settings.options
      local changed = self.changed
      local dim = Segmented(
        {"0", "60", "120", "300", "600"},
        {"Never", "1 min", "2 min", "5 min", "10 min"},
        tostring(options.dimAfter),
        fn(choice: string)
          options.dimAfter = (choice as integer?) ?? 0
          changed()
        end
      )
      local rows: table<View> = {Row("Dim display after", dim)}
      -- How dim: how much of its brightness the screen keeps. And
      -- whether what is on it is blurred as it dims.
      local how = Segmented(
        {"10", "30", "50", "70"},
        {"10%", "30%", "50%", "70%"},
        tostring(options.dimTo),
        fn(choice: string)
          options.dimTo = (choice as integer?) ?? 30
          changed()
        end
      )
      Table.insert(rows, Row("Dimmed brightness", how))
      local blur = Toggle(value: options.dimBlur, onChanged: fn(on: boolean)
        options.dimBlur = on
        changed()
      end)
      Table.insert(rows, Row("Blur display when dimmed", blur))
      local said = "Time is measured from the last keyboard or pointer activity."
      if machine.hasPassword then
        local lock = Segmented(
          {"0", "120", "300", "600", "1800"},
          {"Never", "2 min", "5 min", "10 min", "30 min"},
          tostring(options.lockAfter),
          fn(choice: string)
            options.lockAfter = (choice as integer?) ?? 0
            changed()
          end
        )
        Table.insert(rows, Row("Lock screen after", lock))
      else
        said ..= " Set a login password to lock the screen automatically."
      end
      Table.insert(items, Group("When Inactive", rows))
      Table.insert(items, Said.note(said))
    end
    return Said.pane(items)
  end
end
