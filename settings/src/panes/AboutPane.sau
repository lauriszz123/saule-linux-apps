-- What this system is: Saule's version, the kernel, memory, the screen —
-- like the Mac's About. Asked about again every second while the pane is
-- open, so what changes (the open windows, the time up) is shown as it
-- is now.

from uikit import *
from "wmapi" import SystemInfo, WmSettings
from model import SystemSettings
from theme import Style
from views import Group, PaneTitle, Row, RowButton, Said

export class AboutPane extends View
  settings: SystemSettings

  fn init(settings: SystemSettings, key: string? = nil)
    self.super(key)
    self.settings = settings
  end

  -- How often the system is asked about again, in seconds.
  static every: float = 1.0

  -- It has a tick to run: see `View.ticks`.
  fn ticks() -> boolean
    return true
  end

  -- Ask again every `every` seconds, and build the pane again when what
  -- it says changed: the open windows, the time up.
  fn tick(el: Element, dt: float) -> nil
    local bag: table = el.data.scratch
    local waited = ((bag.waited as float?) ?? 0.0) + dt
    if waited < AboutPane.every then
      bag.waited = waited
      return
    end
    bag.waited = 0.0

    local before = AboutPane.said(self.settings.info)
    self.settings.refreshInfo()
    if AboutPane.said(self.settings.info) != before then
      el.markNeedsBuild()
    end
  end

  -- Everything the pane says of `info`, to tell when it changed.
  static fn said(info: SystemInfo) -> string
    local values: table<string> = {
      AboutPane.title(info),
      AboutPane.version(info),
    }
    for fact in AboutPane.facts(info) do
      Table.insert(values, fact[2])
    end
    return String.join("\n", values)
  end

  -- The system the pane is about: Saule Linux on its own screen; in a
  -- window on another system, that one ("macOS", "Windows 11 Pro").
  static fn title(info: SystemInfo) -> string
    if info.host != "saule" and info.system != "" then
      return info.system
    end
    return "Saule Linux"
  end

  -- Under it, the version: Saule Linux's own (`system`) on its own
  -- screen; in a window on another system, that system's and Saule's.
  -- With neither known, Saule's alone.
  static fn version(info: SystemInfo, system: string = "") -> string
    local saule = "Saule " .. info.saule
    if info.host != "saule" and info.systemVersion != "" then
      return "Version " .. info.systemVersion .. " · " .. saule
    end
    if system != "" then
      return "Version " .. system
    end
    return saule
  end

  -- "Apple M1, 8 threads", as About This System says it.
  static fn processor(info: SystemInfo) -> string
    if info.processor != "" and info.cores > 1 then
      return info.processor .. ", " .. info.cores .. " threads"
    end
    return info.processor
  end

  -- What is said of the software running, in order: each a name and
  -- its value.
  static fn software(info: SystemInfo) -> table<table<string>>
    return {
      {"Saule", info.saule},
      {"Window Manager", info.wm},
      {"Kernel", info.kernel},
      {"Open Windows", tostring(info.windows)},
      {"Uptime", AboutPane.duration(info.uptime)},
    }
  end

  -- What is said of the computer itself.
  static fn hardware(info: SystemInfo) -> table<table<string>>
    local display = ""
    if info.screenWidth > 0 then
      display = info.screenWidth .. " × " .. info.screenHeight
    end
    return {
      {"Model", info.machine},
      {"Processor", AboutPane.processor(info)},
      {"Graphics", info.graphics},
      {"Memory", AboutPane.memory(info)},
      {"Storage", info.storage},
      {"Display", display},
    }
  end

  -- Both, for telling when anything shown changed.
  static fn facts(info: SystemInfo) -> table<table<string>>
    local out = AboutPane.software(info)
    for fact in AboutPane.hardware(info) do
      Table.insert(out, fact)
    end
    return out
  end

  fn body(context: BuildContext) -> View
    local settings = self.settings
    local info = settings.info

    local system = AboutPane.title(info)
    local name = Text(system).font(18.0).foregroundStyle(Style.text)
    local version = AboutPane.version(info, settings.machine.version)
    local said = Text(version).font(12.0).foregroundStyle(Style.dimText)

    local software: table<View> = {}
    for fact in AboutPane.software(info) do
      Table.insert(software, AboutPane.fact(fact[1], fact[2]))
    end
    local hardware: table<View> = {}
    for fact in AboutPane.hardware(info) do
      Table.insert(hardware, AboutPane.fact(fact[1], fact[2]))
    end

    local title = VStack(alignment: StackAlignment.Leading, spacing: 4.0) do
      show(name)
      show(said)
    end
    local report = RowButton("Save to USB Drive", fn()
      settings.tell(fn(wm: WmSettings)
        wm.saveReport()
      end)
    end)
    -- In a pane that scrolls, as the others are: on a netbook's screen
    -- the facts alone are taller than the window.
    return Said.pane({
      PaneTitle("About"),
      title,
      Group("Operating System", software),
      Group("System", hardware),
      Group("Support", {Row("System report", report)}),
    })
  end

  -- How much memory the computer has, from the kB the system counts:
  -- "512 MB", "1 GB", "1.5 GB", "8 GB".
  --
  -- The system counts a little less than is fitted (the firmware and
  -- the graphics chip keep some back), so the count is taken up to the
  -- next size memory comes in: a quarter of a gigabyte under four, a
  -- whole one from there.
  static fn memory(info: SystemInfo) -> string
    if info.memory <= 0 then
      return ""
    end
    local megabytes = (info.memory + 1023) / 1024
    local step = 1024
    if megabytes < 4096 then
      step = 256
    end
    local fitted = (megabytes + step - 1) / step * step
    if fitted < 1024 then
      return fitted .. " MB"
    end
    if fitted % 1024 == 0 then
      return (fitted / 1024) .. " GB"
    end
    -- "1.5", "3.75": halves and quarters, without a nought after them.
    local said = String.format("%.2f", (fitted as float) / 1024.0)
    if String.ends(said, "0") then
      said = String.sub(said, 1, String.len(said) - 1)
    end
    return said .. " GB"
  end

  -- A row that only tells: the value in place of a control. A value that
  -- could not be found is a dash.
  static fn fact(label: string, value: string) -> View
    local shown = value
    if shown == "" then
      shown = "—"
    end
    return Row(label, Text(shown).font(13.0).foregroundStyle(Style.dimText))
  end

  -- "2 h 5 min", "12 min", or a dash before any time is known.
  static fn duration(seconds: integer) -> string
    if seconds <= 0 then
      return ""
    end
    local minutes = Math.floor((seconds as float) / 60.0)
    if minutes < 60 then
      return minutes .. " min"
    end
    local hours = Math.floor((minutes as float) / 60.0)
    return hours .. " h " .. (minutes - hours * 60) .. " min"
  end
end
