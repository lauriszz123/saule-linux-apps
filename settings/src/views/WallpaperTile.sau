-- One wallpaper to pick: a small picture of it, drawn by the same code as
-- the real one (wmapi's `WallpaperArt`), with rounded corners, and ringed
-- in `accent` when it is the one in use. An animated one moves here too.
--
-- Each picture is drawn into an image once and kept, by name and size: a
-- landscape takes many shapes and blurs, which a list of them redrawn
-- every frame would feel. An animated one is drawn again a few times a
-- second, as the window manager draws it.
--
-- Only one picture is drawn for the first time in any frame. A pane of
-- twenty of them drawn at once is most of a second on a netbook, with the
-- window frozen meanwhile; one a frame, the pane is there at once and its
-- pictures fill in, each a plain tile of its own colour until then.

import shine
from uikit import *
from "wmapi" import Preset, WallpaperArt

export class WallpaperTile extends View
  preset: Preset
  chosen: boolean
  accent: Color

  -- The pictures drawn so far, by name and size.
  static local drawn: table<string, Canvas> = {}

  -- How often an animated one is drawn again, a second; when it last
  -- was, and the time it was drawn as.
  static frameRate: float = 20.0
  static local last: float = 0.0
  static local time: float = 0.0

  -- When a picture was last drawn for the first time, and how long after
  -- that the next may be: less than a frame, so it is the next frame's.
  static local firstDrawn: float = -1.0
  static frameGap: float = 0.004

  fn init(preset: Preset, chosen: boolean, accent: Color, key: string? = nil)
    self.super(key)
    self.preset = preset
    self.chosen = chosen
    self.accent = accent
  end

  fn layout(el: Element, constraints: Constraints) -> Size
    return constraints.biggest()
  end

  -- It has a tick to run: see `View.ticks`.
  fn ticks() -> boolean
    return WallpaperArt.moves(self.preset.name)
  end

  -- Every animated tile ticks: the first one due draws them all again.
  fn tick(el: Element, dt: float) -> nil
    local now = Timer.getTime()
    if now - WallpaperTile.last >= 1.0 / WallpaperTile.frameRate then
      WallpaperTile.last = now
      WallpaperTile.time = now
      Repaint.request()
    end
  end

  fn paint(el: Element, x: float, y: float) -> nil
    local w = el.size.width
    local h = el.size.height
    local r = 7.0
    local picture = WallpaperTile.picture(
      self.preset,
      w as integer,
      h as integer
    )
    if picture != nil then
      Graphics.setColor(1.0, 1.0, 1.0)
      Graphics.drawRounded(picture!, x, y, r)
    else
      -- Not its turn yet: its colour, and another frame to draw it in.
      local c = self.preset.colours[1]
      Graphics.setColor(c.r, c.g, c.b, 1.0)
      Graphics.rectangle("fill", x, y, w, h, r)
      Repaint.request()
    end

    -- A hairline round it, so a light one stands off the window.
    Graphics.setColor(1.0, 1.0, 1.0, 0.12)
    Graphics.setLineWidth(1.0)
    Graphics.rectangle("line", x + 0.5, y + 0.5, w - 1.0, h - 1.0, r)

    if self.chosen then
      self.accent.apply()
      Graphics.setLineWidth(2.5)
      Graphics.rectangle("line", x - 3.0, y - 3.0, w + 6.0, h + 6.0, r + 3.0)
    end
  end

  -- The picture of `preset`, `w` × `h`: the one drawn before, or drawn
  -- now; an animated one drawn as it is now. Nil when it has never been
  -- drawn and another was first drawn this frame already.
  static fn picture(preset: Preset, w: integer, h: integer) -> Canvas?
    local key = preset.name .. ":" .. tostring(w) .. "x" .. tostring(h)
    local kept = WallpaperTile.drawn[key]
    local moves = WallpaperArt.moves(preset.name)
    if kept != nil and not moves then
      return kept!
    end
    if kept == nil then
      local since = Timer.getTime() - WallpaperTile.firstDrawn
      if WallpaperTile.firstDrawn >= 0.0 and since < WallpaperTile.frameGap then
        return nil
      end
    end
    local image = kept ?? Graphics.newCanvas(w, h)
    local screen = Graphics.getCanvas()
    local sx, sy, sw, sh = Graphics.getScissor()
    Graphics.push("all")
    Graphics.setCanvas(image)
    Graphics.origin()
    Graphics.setScissor()
    WallpaperArt.paint(
      preset.name,
      0.0,
      0.0,
      w as float,
      h as float,
      WallpaperTile.time
    )
    Graphics.pop()
    Graphics.setCanvas(screen)
    Graphics.setScissor(sx, sy, sw, sh)
    WallpaperTile.drawn[key] = image
    if kept == nil then
      WallpaperTile.firstDrawn = Timer.getTime()
    end
    return image
  end
end
