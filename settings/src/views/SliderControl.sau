-- A slider with its value written beside it, for a row of a group.

from uikit import *
from theme import Style

export class SliderControl extends View
  value: float
  min: float
  max: float
  step: float

  -- What the value reads as: "8 px", "10".
  unit: string

  -- How the number is written, as `String.format` takes it: "%.0f" a
  -- whole number, "%.2f" two places.
  format: string

  onChanged: ValueChanged<float>

  fn init(
    value: float,
    min: float,
    max: float,
    step: float,
    unit: string,
    onChanged: ValueChanged<float>,
    format: string = "%.0f",
    key: string? = nil
  )
    self.super(key)
    self.value = value
    self.min = min
    self.max = max
    self.step = step
    self.unit = unit
    self.onChanged = onChanged
    self.format = format
  end

  fn body(context: BuildContext) -> View
    local slider = Slider(
      value: self.value,
      min: self.min,
      max: self.max,
      step: self.step,
      width: 130.0,
      onChanged: self.onChanged
    )
    local said = String.format(self.format, self.value) .. self.unit
    local shown = Text(said).font(12.0).foregroundStyle(Style.dimText)
    -- As wide as the slider and its number, so it sits beside its label
    -- where there is room, as a row's control should.
    local fit = StackSize.Fit
    local centre = StackAlignment.Center
    return HStack(alignment: centre, spacing: 8.0, sizing: fit) do
      show(slider)
      shown.frame(width: 40.0)
    end
  end
end
