-- The icon of a kind of thing that takes up storage, as the Mac's Storage
-- lists them: a white symbol on a rounded square of the kind's colour.
-- The same colour is its stretch of the bar above the list.

import shine
from uikit import *

export class CategoryIcon extends View
  -- "Applications", "Documents", "Settings", "Wallpapers", "Saule Linux"
  -- or "Other".
  name: string

  fn init(name: string, key: string? = nil)
    self.super(key)
    self.name = name
  end

  fn layout(el: Element, constraints: Constraints) -> Size
    return constraints.biggest()
  end

  static fn colour(name: string) -> Color
    return match name
      case "Applications" then Color(0.25, 0.52, 0.96)
      case "Documents" then Color(0.40, 0.38, 0.90)
      case "Settings" then Color(0.56, 0.57, 0.61)
      case "Wallpapers" then Color(0.16, 0.68, 0.84)
      case "Saule Linux" then Color(0.98, 0.62, 0.16)
      case _ then Color(0.42, 0.43, 0.47)
    end
  end

  fn paint(el: Element, x: float, y: float) -> nil
    local s = Math.min(el.size.width, el.size.height)
    CategoryIcon.colour(self.name).apply()
    Graphics.rectangle("fill", x, y, s, s, s * 0.24)

    Graphics.setColor(1.0, 1.0, 1.0)
    match self.name
      case "Applications" then CategoryIcon.grid(x, y, s)
      case "Documents" then CategoryIcon.page(self.name, x, y, s)
      case "Settings" then CategoryIcon.sliders(self.name, x, y, s)
      case "Wallpapers" then CategoryIcon.landscape(x, y, s)
      case "Saule Linux" then CategoryIcon.sun(x, y, s)
      case _ then CategoryIcon.dots(x, y, s)
    end
  end

  -- Four apps in a square.
  static fn grid(x: float, y: float, s: float) -> nil
    local cell = s * 0.24
    local start = s * 0.22
    local step = cell + s * 0.08
    for row = 0, 1 do
      for column = 0, 1 do
        local cx = x + start + (column as float) * step
        local cy = y + start + (row as float) * step
        Graphics.rectangle("fill", cx, cy, cell, cell, cell * 0.28)
      end
    end
  end

  -- A page with lines of writing.
  static fn page(name: string, x: float, y: float, s: float) -> nil
    local left = x + s * 0.28
    local top = y + s * 0.2
    Graphics.rectangle("fill", left, top, s * 0.44, s * 0.6, s * 0.06)
    CategoryIcon.colour(name).apply()
    local line = Math.max(s * 0.05, 1.0)
    for i = 0, 2 do
      local ly = top + s * (0.15 + 0.13 * (i as float))
      local lw = s * (0.28 - 0.07 * ((i / 2) as float))
      Graphics.rectangle("fill", left + s * 0.08, ly, lw, line)
    end
  end

  -- Three sliders, each set somewhere else.
  static fn sliders(name: string, x: float, y: float, s: float) -> nil
    local bar = Math.max(s * 0.06, 1.0)
    local knobs = {0.64, 0.38, 0.56}
    for i = 1, 3 do
      local cy = y + s * (0.14 + 0.18 * (i as float))
      Graphics.rectangle(
        "fill",
        x + s * 0.22,
        cy - bar / 2.0,
        s * 0.56,
        bar,
        bar / 2.0
      )
      Graphics.circle("fill", x + s * knobs[i], cy, s * 0.085)
    end
  end

  -- A mountain under a sun.
  static fn landscape(x: float, y: float, s: float) -> nil
    Graphics.circle("fill", x + s * 0.68, y + s * 0.32, s * 0.09)
    Graphics.polygon(
      "fill",
      {
        x + s * 0.18,
        y + s * 0.74,
        x + s * 0.42,
        y + s * 0.36,
        x + s * 0.62,
        y + s * 0.74,
      }
    )
    Graphics.polygon(
      "fill",
      {
        x + s * 0.46,
        y + s * 0.74,
        x + s * 0.62,
        y + s * 0.5,
        x + s * 0.82,
        y + s * 0.74,
      }
    )
  end

  -- The sun: Saule itself.
  static fn sun(x: float, y: float, s: float) -> nil
    local cx = x + s * 0.5
    local cy = y + s * 0.5
    Graphics.circle("fill", cx, cy, s * 0.15)
    Graphics.setLineWidth(Math.max(s * 0.07, 1.0))
    for i = 0, 7 do
      local angle = Math.pi * (i as float) / 4.0
      local dx = Math.cos(angle)
      local dy = Math.sin(angle)
      Graphics.line(
        cx + dx * s * 0.24,
        cy + dy * s * 0.24,
        cx + dx * s * 0.34,
        cy + dy * s * 0.34
      )
    end
  end

  -- Everything else.
  static fn dots(x: float, y: float, s: float) -> nil
    for i = 0, 2 do
      Graphics.circle(
        "fill",
        x + s * (0.3 + 0.2 * (i as float)),
        y + s * 0.5,
        s * 0.06
      )
    end
  end
end
