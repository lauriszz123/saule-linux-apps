-- A pane's icon, as the Mac draws them: a white symbol on a rounded square
-- of the pane's colour. Drawn rather than taken from an icon font, which
-- an app can't ship yet; each symbol is a few shapes.

import shine
from uikit import *
from model import Pane

export class PaneIcon extends View
  pane: Pane

  fn init(pane: Pane, key: string? = nil)
    self.super(key)
    self.pane = pane
  end

  fn layout(el: Element, constraints: Constraints) -> Size
    return constraints.biggest()
  end

  fn paint(el: Element, x: float, y: float) -> nil
    local s = Math.min(el.size.width, el.size.height)
    PaneIcon.colour(self.pane).apply()
    Graphics.rectangle("fill", x, y, s, s, s * 0.24)

    Graphics.setColor(1.0, 1.0, 1.0)
    match self.pane
      case Pane.Windows then PaneIcon.windows(x, y, s)
      case Pane.Appearance then PaneIcon.appearance(x, y, s)
      case Pane.Wallpaper then PaneIcon.wallpaper(x, y, s)
      case Pane.Keyboard then PaneIcon.keyboard(x, y, s)
      case Pane.Mouse then PaneIcon.mouse(x, y, s)
      case Pane.Storage then PaneIcon.storage(x, y, s)
      case Pane.About then PaneIcon.about(x, y, s)
      case Pane.Wifi then PaneIcon.wifi(x, y, s)
      case Pane.Bluetooth then PaneIcon.bluetooth(x, y, s)
      case Pane.Network then PaneIcon.network(x, y, s)
      case Pane.Sound then PaneIcon.sound(x, y, s)
      case Pane.General then PaneIcon.general(x, y, s)
      case Pane.Displays then PaneIcon.displays(x, y, s)
      case Pane.Password then PaneIcon.password(x, y, s)
      case Pane.Trackpad then PaneIcon.trackpad(x, y, s)
      case Pane.DateTime then PaneIcon.dateTime(x, y, s)
    end
  end

  static fn colour(pane: Pane) -> Color
    return match pane
      case Pane.Windows then Color(0.25, 0.52, 0.96)
      case Pane.Appearance then Color(0.33, 0.34, 0.38)
      case Pane.Wallpaper then Color(0.16, 0.66, 0.84)
      case Pane.Keyboard then Color(0.42, 0.40, 0.78)
      case Pane.Mouse then Color(0.20, 0.62, 0.52)
      case Pane.Storage then Color(0.55, 0.56, 0.60)
      case Pane.About then Color(0.52, 0.53, 0.58)
      case Pane.Wifi then Color(0.20, 0.52, 0.96)
      case Pane.Bluetooth then Color(0.20, 0.52, 0.96)
      case Pane.Network then Color(0.20, 0.52, 0.96)
      case Pane.Sound then Color(0.93, 0.30, 0.42)
      case Pane.General then Color(0.52, 0.53, 0.58)
      case Pane.Displays then Color(0.22, 0.56, 0.95)
      case Pane.Password then Color(0.90, 0.36, 0.34)
      case Pane.Trackpad then Color(0.52, 0.53, 0.58)
      case Pane.DateTime then Color(0.22, 0.56, 0.95)
    end
  end

  -- The Bluetooth mark: an upright with two points to its right, each
  -- crossed back to the other side.
  static fn bluetooth(x: float, y: float, s: float) -> nil
    local cx = x + s * 0.5
    Graphics.setLineWidth(Math.max(s * 0.07, 1.2))
    Graphics.line(cx, y + s * 0.2, cx, y + s * 0.8)
    Graphics.line(cx, y + s * 0.2, cx + s * 0.16, y + s * 0.36)
    Graphics.line(cx + s * 0.16, y + s * 0.36, cx - s * 0.16, y + s * 0.64)
    Graphics.line(cx, y + s * 0.8, cx + s * 0.16, y + s * 0.64)
    Graphics.line(cx + s * 0.16, y + s * 0.64, cx - s * 0.16, y + s * 0.36)
  end

  -- A dot and three arcs opening upward.
  static fn wifi(x: float, y: float, s: float) -> nil
    local cx = x + s * 0.5
    local cy = y + s * 0.74
    Graphics.circle("fill", cx, cy, s * 0.06)
    Graphics.setLineWidth(Math.max(s * 0.07, 1.2))
    for arc = 1, 3 do
      Graphics.arc(
        "line",
        cx,
        cy,
        s * (0.06 + 0.16 * (arc as float)),
        -Math.pi * 0.75,
        -Math.pi * 0.25,
        "open"
      )
    end
  end

  -- A globe: a circle, its equator and a meridian.
  static fn network(x: float, y: float, s: float) -> nil
    local cx = x + s * 0.5
    local cy = y + s * 0.5
    local r = s * 0.29
    local line = Math.max(s * 0.06, 1.0)
    Graphics.setLineWidth(line)
    Graphics.circle("line", cx, cy, r)
    Graphics.rectangle("fill", cx - r, cy - line / 2.0, r * 2.0, line)
    Graphics.rectangle("fill", cx - line / 2.0, cy - r, line, r * 2.0)
  end

  -- A loudspeaker and two waves.
  static fn sound(x: float, y: float, s: float) -> nil
    local cy = y + s * 0.5
    Graphics.rectangle("fill", x + s * 0.2, cy - s * 0.09, s * 0.14, s * 0.18)
    Graphics.polygon(
      "fill",
      {
        x + s * 0.3,
        cy - s * 0.09,
        x + s * 0.48,
        cy - s * 0.24,
        x + s * 0.48,
        cy + s * 0.24,
        x + s * 0.3,
        cy + s * 0.09,
      }
    )
    Graphics.setLineWidth(Math.max(s * 0.06, 1.0))
    for wave = 1, 2 do
      Graphics.arc(
        "line",
        x + s * 0.48,
        cy,
        s * (0.06 + 0.12 * (wave as float)),
        -Math.pi * 0.25,
        Math.pi * 0.25,
        "open"
      )
    end
  end

  -- A gear: a ring with eight teeth.
  static fn general(x: float, y: float, s: float) -> nil
    local cx = x + s * 0.5
    local cy = y + s * 0.5
    Graphics.setLineWidth(Math.max(s * 0.1, 1.5))
    Graphics.circle("line", cx, cy, s * 0.19)
    local tooth = s * 0.1
    for i = 0, 7 do
      local angle = Math.pi * (i as float) / 4.0
      local tx = cx + Math.cos(angle) * s * 0.29
      local ty = cy + Math.sin(angle) * s * 0.29
      Graphics.circle("fill", tx, ty, tooth / 2.0)
    end
  end

  -- A screen on its foot.
  static fn displays(x: float, y: float, s: float) -> nil
    Graphics.rectangle(
      "fill",
      x + s * 0.17,
      y + s * 0.24,
      s * 0.66,
      s * 0.42,
      s * 0.06
    )
    Graphics.rectangle("fill", x + s * 0.45, y + s * 0.66, s * 0.1, s * 0.08)
    Graphics.rectangle(
      "fill",
      x + s * 0.33,
      y + s * 0.73,
      s * 0.34,
      s * 0.06,
      s * 0.03
    )
  end

  -- A padlock.
  static fn password(x: float, y: float, s: float) -> nil
    Graphics.setLineWidth(Math.max(s * 0.08, 1.2))
    Graphics.arc(
      "line",
      x + s * 0.5,
      y + s * 0.42,
      s * 0.14,
      -Math.pi,
      0.0,
      "open"
    )
    Graphics.rectangle(
      "fill",
      x + s * 0.27,
      y + s * 0.42,
      s * 0.46,
      s * 0.36,
      s * 0.07
    )
  end

  -- A pad with its button line.
  static fn trackpad(x: float, y: float, s: float) -> nil
    local left = x + s * 0.18
    local top = y + s * 0.26
    Graphics.rectangle("fill", left, top, s * 0.64, s * 0.48, s * 0.08)
    PaneIcon.colour(Pane.Trackpad).apply()
    local line = Math.max(s * 0.04, 1.0)
    Graphics.rectangle("fill", left, top + s * 0.34, s * 0.64, line)
  end

  -- A clock at ten past ten.
  static fn dateTime(x: float, y: float, s: float) -> nil
    local cx = x + s * 0.5
    local cy = y + s * 0.5
    Graphics.circle("fill", cx, cy, s * 0.3)
    PaneIcon.colour(Pane.DateTime).apply()
    Graphics.setLineWidth(Math.max(s * 0.07, 1.2))
    Graphics.line(cx, cy, cx - s * 0.13, cy - s * 0.1)
    Graphics.line(cx, cy, cx + s * 0.15, cy - s * 0.13)
  end

  -- Two windows side by side: the tiling.
  static fn windows(x: float, y: float, s: float) -> nil
    local w = s * 0.27
    local h = s * 0.5
    local top = y + s * 0.25
    Graphics.rectangle("fill", x + s * 0.2, top, w, h, s * 0.05)
    Graphics.rectangle("fill", x + s * 0.53, top, w, h, s * 0.05)
  end

  -- A circle, half light and half dark.
  static fn appearance(x: float, y: float, s: float) -> nil
    local cx = x + s * 0.5
    local cy = y + s * 0.5
    local r = s * 0.28
    Graphics.setLineWidth(Math.max(s * 0.07, 1.0))
    Graphics.circle("line", cx, cy, r)

    -- The left half, filled: a fan of points round the half circle.
    local points: table<float> = {}
    for i = 0, 12 do
      local angle = Math.pi * 0.5 + Math.pi * (i as float) / 12.0
      Table.insert(points, cx + Math.cos(angle) * r)
      Table.insert(points, cy - Math.sin(angle) * r)
    end
    Graphics.polygon("fill", points)
  end

  -- A mountain under a sun.
  static fn wallpaper(x: float, y: float, s: float) -> nil
    Graphics.circle("fill", x + s * 0.68, y + s * 0.32, s * 0.09)
    Graphics.polygon(
      "fill",
      {
        x + s * 0.18,
        y + s * 0.74,
        x + s * 0.42,
        y + s * 0.36,
        x + s * 0.62,
        y + s * 0.74,
      }
    )
    Graphics.polygon(
      "fill",
      {
        x + s * 0.46,
        y + s * 0.74,
        x + s * 0.62,
        y + s * 0.5,
        x + s * 0.82,
        y + s * 0.74,
      }
    )
  end

  -- A keyboard: a white board with two rows of keys and a space bar cut
  -- out of it in the icon's colour.
  static fn keyboard(x: float, y: float, s: float) -> nil
    local left = x + s * 0.16
    local top = y + s * 0.3
    local w = s * 0.68
    Graphics.rectangle("fill", left, top, w, s * 0.4, s * 0.07)

    PaneIcon.colour(Pane.Keyboard).apply()
    local key = s * 0.09
    local step = s * 0.135
    for row = 0, 1 do
      for column = 0, 3 do
        local kx = left + s * 0.08 + (column as float) * step
        local ky = top + s * 0.06 + (row as float) * s * 0.11
        Graphics.rectangle("fill", kx, ky, key, key * 0.8, key * 0.2)
      end
    end
    local bar = top + s * 0.28
    Graphics.rectangle("fill", left + s * 0.17, bar, s * 0.34, key * 0.7, 1.0)
  end

  -- A mouse: a white rounded body, its buttons split by a line and the
  -- wheel between them, in the icon's colour.
  static fn mouse(x: float, y: float, s: float) -> nil
    local w = s * 0.36
    local h = s * 0.56
    local left = x + (s - w) / 2.0
    local top = y + (s - h) / 2.0
    Graphics.rectangle("fill", left, top, w, h, w / 2.0)

    PaneIcon.colour(Pane.Mouse).apply()
    local cx = x + s / 2.0
    local line = Math.max(s * 0.04, 1.0)
    Graphics.rectangle("fill", left, top + h * 0.42, w, line)
    Graphics.rectangle("fill", cx - line / 2.0, top, line, h * 0.42)
    local wheel = s * 0.06
    Graphics.rectangle(
      "fill",
      cx - wheel / 2.0,
      top + h * 0.12,
      wheel,
      h * 0.18,
      wheel / 2.0
    )
  end

  -- A drive, as the Mac's Storage icon: a white box seen from the front,
  -- its light a dot at the right.
  static fn storage(x: float, y: float, s: float) -> nil
    local left = x + s * 0.18
    local top = y + s * 0.34
    local w = s * 0.64
    local h = s * 0.32
    Graphics.rectangle("fill", left, top, w, h, s * 0.07)
    PaneIcon.colour(Pane.Storage).apply()
    local line = Math.max(s * 0.04, 1.0)
    Graphics.rectangle("fill", left, top + h * 0.55, w, line)
    Graphics.circle("fill", left + w - s * 0.1, top + h * 0.78, s * 0.035)
  end

  -- An "i".
  static fn about(x: float, y: float, s: float) -> nil
    local w = s * 0.12
    Graphics.circle("fill", x + s * 0.5, y + s * 0.28, w * 0.7)
    Graphics.rectangle(
      "fill",
      x + s * 0.5 - w / 2.0,
      y + s * 0.42,
      w,
      s * 0.34,
      w / 2.0
    )
  end
end
