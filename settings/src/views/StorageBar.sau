-- How full a volume is, as the Mac's Storage shows it: one rounded bar,
-- a stretch of it in the colour of each kind of thing, a hairline between
-- them, and what is free left as the empty track.
--
-- A kind that takes up almost nothing still gets a sliver, so the bar
-- shows everything its legend names.

import shine
from uikit import *

export class StorageBar extends View
  -- Each stretch's bytes and colour, in order, and the volume's size.
  sizes: table<integer>
  colours: table<Color>
  total: integer

  static track: Color = Color(1.0, 1.0, 1.0, 0.10)
  static hairline: float = 1.0
  static sliver: float = 3.0

  fn init(
    sizes: table<integer>,
    colours: table<Color>,
    total: integer,
    key: string? = nil
  )
    self.super(key)
    self.sizes = sizes
    self.colours = colours
    self.total = total
  end

  fn layout(el: Element, constraints: Constraints) -> Size
    return constraints.biggest()
  end

  fn paint(el: Element, x: float, y: float) -> nil
    local w = el.size.width
    local h = el.size.height
    local r = Math.min(h * 0.3, 6.0)
    StorageBar.track.apply()
    Graphics.rectangle("fill", x, y, w, h, r)
    if self.total <= 0 then
      return
    end

    -- Each stretch is the whole bar in its colour, cut to its own span: so
    -- the ends are the bar's round ends and every join is straight.
    local sx, sy, sw, sh = Graphics.getScissor()
    local at = x
    for i = 1, #self.sizes do
      local bytes = self.sizes[i]
      local room = x + w - at
      if bytes > 0 and room > 0.0 then
        local share = (bytes as float) / (self.total as float) * w
        local span = Math.max(
          Math.floor(share + 0.5) as float,
          StorageBar.sliver
        )
        span = Math.min(span, room)
        Graphics.intersectScissor(at, y, span, h)
        self.colours[i].apply()
        Graphics.rectangle("fill", x, y, w, h, r)
        Graphics.setScissor(sx, sy, sw, sh)
        at += span + StorageBar.hairline
      end
    end
  end
end
