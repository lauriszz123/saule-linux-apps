-- Settings as a uikit app: one window, a sidebar of panes beside the pane
-- that is open. Started with a pane's name (`settings storage`), it opens
-- on that pane.

from uikit import *
from model import SystemSettings
from SettingsWindow import SettingsWindow

export class SettingsApp extends App
  settings: SystemSettings

  fn init()
    self.super()
    self.settings = SystemSettings()
  end

  fn body() -> Scene
    return WindowGroup(title: "Settings", width: 720, height: 480) do
      SettingsWindow(self.settings, SettingsWindow.place(Os.args()[1] ?? ""))
    end
  end
end
