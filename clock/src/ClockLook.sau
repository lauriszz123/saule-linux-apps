-- Clock's colours: dark, as the system is.

from uikit import Color, TextStyle, ThemeData

export class ClockLook
  static window: Color = Color(0.13, 0.13, 0.15)
  static bar: Color = Color(0.19, 0.19, 0.21)
  static hairline: Color = Color(0.0, 0.0, 0.0, 0.45)
  static text: Color = Color(0.95, 0.95, 0.97)
  static dimText: Color = Color(1.0, 1.0, 1.0, 0.55)
  static faint: Color = Color(1.0, 1.0, 1.0, 0.16)
  static accent: Color = Color(0.98, 0.58, 0.12)
  static go: Color = Color(0.22, 0.62, 0.36)
  static stop: Color = Color(0.78, 0.26, 0.26)
  static button: Color = Color(1.0, 1.0, 1.0, 0.12)
  static buttonOn: Color = Color(1.0, 1.0, 1.0, 0.26)
  static well: Color = Color(0.0, 0.0, 0.0, 0.25)
  static stripe: Color = Color(1.0, 1.0, 1.0, 0.03)

  -- The days of the week, Sunday first, as `Date.weekday` counts them.
  static weekdays: table<string> = {
    "Sunday",
    "Monday",
    "Tuesday",
    "Wednesday",
    "Thursday",
    "Friday",
    "Saturday",
  }

  static fn theme() -> ThemeData
    return ThemeData(
      background: ClockLook.window,
      surface: ClockLook.bar,
      border: ClockLook.faint,
      text: ClockLook.text,
      textMuted: ClockLook.dimText,
      primary: ClockLook.accent,
      body: TextStyle(ClockLook.text, 13.0)
    )
  end

  -- Two digits: "07".
  static fn two(n: integer) -> string
    if n < 10 then
      return "0" .. n
    end
    return tostring(n)
  end
end
