-- A row of choices of which one is in force, as one control: the
-- window's four views, and whose processes are listed.

from uikit import *
from Look import Look

export class Segments extends View
  -- What each choice is called, and what it is.
  titles: table<string>
  values: table<string>
  chosen: string
  onChosen: ValueChanged<string>

  fn init(
    titles: table<string>,
    values: table<string>,
    chosen: string,
    onChosen: ValueChanged<string>,
    key: string? = nil
  )
    self.super(key)
    self.titles = titles
    self.values = values
    self.chosen = chosen
    self.onChosen = onChosen
  end

  fn body(context: BuildContext) -> View
    local parts: table<View> = {}
    for i = 1, #self.titles do
      local value = self.values[i]
      local choose = self.onChosen
      local ink = Look.dimText
      local fill: Color? = nil
      if value == self.chosen then
        ink = Look.text
        fill = Look.buttonOn
      end
      local label = Text(self.titles[i]).font(12.0).foregroundStyle(ink)
      local inset = EdgeInsets.symmetric(horizontal: 12.0, vertical: 4.0)
      local part = label.lineLimit(1).padding(insets: inset).background(fill, 5.0)
      Table.insert(parts, GestureArea(child: part, onTap: fn()
        choose(value)
      end, key: value))
    end
    local row = HStack(
      alignment: StackAlignment.Center,
      sizing: StackSize.Fit,
      spacing: 2.0,
      children: parts
    )
    return row.padding(2.0).background(Look.well, 7.0)
  end
end
