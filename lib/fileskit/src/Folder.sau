-- Reading a folder: everything in it, each with its size and date, in
-- the order asked for.
--
-- Asked of Saule itself (`Os.list`, `Os.fsInfo`), a name at a time, and
-- of no other program: a folder open in a window is read again every
-- few seconds, and starting `stat` for it stopped the window for as
-- long as that took, which on a slow machine could be seen. Links are
-- followed, so a link to a folder opens as one; a link to nothing is
-- left out.

from Entry import Entry
from Shell import Shell

export enum SortBy
  Name,
  Modified,
  Size,
  Kind
end

export class Folder
  -- Everything in `path`, folders and files together, by name (or in
  -- no order, for a caller that puts them in its own). Nil when it
  -- can't be read: no such folder, or no leave to look in it.
  static fn list(
    path: string,
    hidden: boolean = false,
    sorted: boolean = true
  ) -> table<Entry>?
    if not Os.exists(path) then
      return nil
    end
    local names: table<string> = {}
    try
      names = Os.list(path)
    catch e: string
      return nil
    end

    local base = path
    if not String.ends(base, "/") then
      base = base .. "/"
    end
    local found: table<Entry> = {}
    for name in names do
      if hidden or not String.starts(name, ".") then
        local entry = Folder.read(name, base .. name)
        if entry != nil then
          Table.insert(found, entry!)
        end
      end
    end
    if sorted then
      Folder.sort(found, SortBy.Name, true)
    end
    return found
  end

  -- What is at `path`, called `name`. Nil for what has gone since it
  -- was listed, and for a link to nothing.
  static fn read(name: string, path: string) -> Entry?
    local info = Os.fsInfo(path)
    if info == nil then
      return nil
    end
    local folder = info!.kind == FsKind.Dir
    if info!.kind == FsKind.Symlink then
      -- `Os.fsInfo` describes the link itself. Asked about "." inside
      -- it, it has to go through the link, and answers only when a
      -- folder is at the end of it.
      local through = Os.fsInfo(path .. "/.")
      if through != nil then
        info = through
        folder = true
      elseif not Os.exists(path) then
        return nil
      end
    end
    return Entry(name, path, folder, info!.size, info!.modifiedAt ?? 0)
  end

  -- Put `entries` in order: by `by`, forwards or backwards. Names are
  -- compared without regard to capitals, as a person reads them, and
  -- settle what `by` leaves equal.
  static fn sort(entries: table<Entry>, by: SortBy, ascending: boolean) -> nil
    local before = fn(a: Entry, b: Entry) -> boolean
      match by
        case SortBy.Modified then
          if a.modified != b.modified then
            return a.modified < b.modified
          end
        case SortBy.Size then
          if a.size != b.size then
            return a.size < b.size
          end
        case SortBy.Kind then
          if a.kind() != b.kind() then
            return a.kind() < b.kind()
          end
        case SortBy.Name then nil
      end
      return a.folded < b.folded
    end
    Table.sort(entries, fn(a: Entry, b: Entry) -> boolean
      if ascending then
        return before(a, b)
      end
      return before(b, a)
    end)
  end

  -- The folder `path` is in; "/" is in itself.
  static fn parent(path: string) -> string
    local trimmed = path
    while String.len(trimmed) > 1 and String.ends(trimmed, "/") do
      trimmed = String.sub(trimmed, 1, String.len(trimmed) - 1)
    end
    for i = String.len(trimmed), 1, -1 do
      if String.sub(trimmed, i, i) == "/" then
        if i == 1 then
          return "/"
        end
        return String.sub(trimmed, 1, i - 1)
      end
    end
    return "/"
  end

  -- The last part of `path`: what it is called.
  static fn nameOf(path: string) -> string
    if path == "/" then
      return "Computer"
    end
    local parts = String.split(path, "/")
    for i = #parts, 1, -1 do
      if parts[i] != "" then
        return parts[i]
      end
    end
    return path
  end

  -- `name` inside `folder`.
  static fn join(folder: string, name: string) -> string
    if String.ends(folder, "/") then
      return folder .. name
    end
    return folder .. "/" .. name
  end

  -- How much room is left on the disk `path` is on, in bytes, from what
  -- `df -k` printed about it; -1 when that can't be told.
  static fn availableIn(out: string) -> integer
    local lines = String.split(String.trim(out), "\n")
    local words: table<string> = {}
    for word in String.split(lines[#lines], " ") do
      if word != "" then
        Table.insert(words, word)
      end
    end
    -- "Filesystem 1K-blocks Used Available Use% Mounted on": the fourth,
    -- or the third where a long device name took a line to itself.
    local at = 4
    if #words == 5 then
      at = 3
    end
    local kilobytes = words[at] as integer?
    if kilobytes == nil then
      return -1
    end
    return kilobytes! * 1024
  end
end

-- How much room a disk has left, asked without waiting for the answer.
--
-- `df` is another program, and a window that stops until it has
-- finished stops for as long as starting a program takes: every time a
-- folder was opened. `ask` starts it and comes straight back; `take`
-- has the answer once there is one.
export class Room
  static local query: Process? = nil
  static local output: string = ""

  -- Ask about the disk `path` is on. A question still waiting for its
  -- answer is dropped: the folder it was about has been left.
  static fn ask(path: string) -> nil
    local running = Room.query
    if running != nil then
      running!.kill()
    end
    Room.output = ""
    Room.query = Os.spawn("df", {"-k", path})
  end

  -- The answer, in bytes (-1: it can't be told), once `df` has finished
  -- and all it printed has been read; nil until then, and after it has
  -- been taken.
  static fn take() -> integer?
    local query = Room.query
    if query == nil then
      return nil
    end
    Room.output ..= Bytes.toString(query!.read()) ?? ""
    local code = query!.poll()
    if code == nil or not query!.atEof() then
      return nil
    end
    Room.query = nil
    if code! != 0 then
      return -1
    end
    return Folder.availableIn(Room.output)
  end
end
