-- The foot of the window: the way to the folder, each step of it a
-- place to go, and at the right how many things are in it and how much
-- room its disk has left. Something that just went wrong is said here
-- instead, for a few seconds.
--
--   Computer › data › home › display › Documents      12 items, 230 GB available

from uikit import *
from "fileskit" import Folder, Places, Said
from model import Browser
from Look import Look

export class PathBar extends View
  browser: Browser
  refresh: Action
  notice: string

  fn init(
    browser: Browser,
    notice: string,
    refresh: Action,
    key: string? = nil
  )
    self.super(key)
    self.browser = browser
    self.notice = notice
    self.refresh = refresh
  end

  fn body(context: BuildContext) -> View
    local browser = self.browser
    local refresh = self.refresh
    local parts: table<View> = {}
    -- How wide the folder is shown: in a narrow window the way is
    -- shorter and the count says less, so that neither is cut off.
    local wide = browser.width <= 0.0 or browser.width >= 430.0
    local roomy = browser.width <= 0.0 or browser.width >= 280.0

    if self.notice != "" then
      local said = Text(self.notice).font(11.0).foregroundStyle(Look.warning)
      Table.insert(parts, said.lineLimit(1))
    else
      -- From the top down: "/", then each folder on the way.
      local steps: table<string> = {}
      local at = browser.folder
      while at != "/" do
        Table.insert(steps, at, 1)
        at = Folder.parent(at)
      end
      Table.insert(steps, "/", 1)
      -- A long way is shown by its end: the last five steps, and fewer
      -- where the window has no room for five.
      local shown = 5
      if not roomy then
        shown = 2
      elseif not wide then
        shown = 3
      end
      local first = Math.max(#steps - shown + 1, 1)
      for i = first, #steps do
        local path = steps[i]
        if i > first then
          local mark = Text("›").font(11.0).foregroundStyle(Look.dimText)
          Table.insert(parts, mark)
        end
        local ink = Look.dimText
        if i == #steps then
          ink = Look.text
        end
        local name = Text(Places.title(path)).font(11.0).foregroundStyle(ink)
        local go = fn()
          browser.go(path)
          refresh()
        end
        Table.insert(parts, GestureArea(child: name.lineLimit(1), onTap: go))
      end
    end

    Table.insert(parts, Spacer())
    local count = Said.items(#browser.entries)
    if browser.available >= 0 and wide then
      count = count .. ", " .. Said.size(browser.available) .. " available"
    end
    if not browser.readable then
      count = "This folder cannot be opened"
    end
    if roomy or not browser.readable then
      local counted = Text(count).font(11.0).foregroundStyle(Look.dimText)
      Table.insert(parts, counted.lineLimit(1))
    end

    local row = HStack(
      alignment: StackAlignment.Center,
      spacing: 5.0,
      children: parts
    )
    local inset = EdgeInsets.symmetric(horizontal: 10.0)
    return row.padding(insets: inset).frame(height: Look.footHeight).background(
      Look.bar
    )
  end
end
