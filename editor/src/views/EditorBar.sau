-- The bar along the top of the window: what is done with the document
-- at the left, its name in the middle (with "Edited" while it has
-- changes not saved, as a Mac says it), and how it is shown at the
-- right.
--
--   [New] [Open…] [Save]        Notes.txt — Edited        [A−] [A+] [Wrap]

from uikit import *
from model import Document
from Look import Look
from ToolButton import ToolButton

export class EditorBar extends View
  document: Document
  wrap: boolean
  onNew: Action
  onOpen: Action
  onSave: Action
  onSmaller: Action
  onLarger: Action
  onWrap: Action
  -- In a narrow window: the buttons of the text's size and wrapping
  -- are left out (both are in the settings), so the rest fit.
  compact: boolean

  fn init(
    document: Document,
    wrap: boolean,
    onNew: Action,
    onOpen: Action,
    onSave: Action,
    onSmaller: Action,
    onLarger: Action,
    onWrap: Action,
    compact: boolean = false,
    key: string? = nil
  )
    self.super(key)
    self.document = document
    self.wrap = wrap
    self.onNew = onNew
    self.onOpen = onOpen
    self.onSave = onSave
    self.onSmaller = onSmaller
    self.onLarger = onLarger
    self.onWrap = onWrap
    self.compact = compact
  end

  fn body(context: BuildContext) -> View
    local document = self.document
    local name = Text(document.title()).font(13.0).foregroundStyle(Look.text)
    local title: table<View> = {name.lineLimit(1)}
    if document.edited() then
      local edited = Text("— Edited").font(13.0)
      Table.insert(title, edited.foregroundStyle(Look.dimText))
    end
    local named = HStack(
      alignment: StackAlignment.Center,
      sizing: StackSize.Fit,
      spacing: 6.0,
      children: title
    )

    local centre = StackAlignment.Center
    local fit = StackSize.Fit
    local left = HStack(alignment: centre, sizing: fit, spacing: 6.0) do
      ToolButton("New", self.onNew)
      ToolButton("Open…", self.onOpen)
      ToolButton("Save", self.onSave)
    end
    local right = HStack(alignment: centre, sizing: fit, spacing: 6.0) do
      ToolButton("A−", self.onSmaller)
      ToolButton("A+", self.onLarger)
      ToolButton("Wrap", self.onWrap, on: self.wrap)
    end

    -- The name sits in the middle of the room between the buttons, and
    -- keeps to it: in a narrow window it is cut short, where it used to
    -- lie over the buttons at its sides.
    local middle = Clip(child: named.centered())
    local compact = self.compact
    local bar = HStack(alignment: centre, spacing: 8.0) do
      show(left)
      middle.expanded()
      if not compact then
        show(right)
      end
    end
    local inset = EdgeInsets.symmetric(horizontal: 10.0)
    return bar.padding(insets: inset).frame(height: Look.barHeight).background(
      Look.bar
    )
  end
end
