-- The editor's colours and sizes: dark, as the system is.

from uikit import Color, TextStyle, ThemeData

export class Look
  static page: Color = Color(0.13, 0.13, 0.15)
  static bar: Color = Color(0.18, 0.18, 0.20)
  static hairline: Color = Color(0.0, 0.0, 0.0, 0.45)
  static text: Color = Color(0.93, 0.93, 0.95)
  static dimText: Color = Color(1.0, 1.0, 1.0, 0.55)
  static warning: Color = Color(1.0, 0.72, 0.42)
  static accent: Color = Color(0.25, 0.48, 0.90)
  static selection: Color = Color(0.25, 0.48, 0.90, 0.45)
  static button: Color = Color(1.0, 1.0, 1.0, 0.10)
  static buttonOn: Color = Color(1.0, 1.0, 1.0, 0.26)
  static card: Color = Color(0.17, 0.17, 0.19)
  static edge: Color = Color(1.0, 1.0, 1.0, 0.14)
  static screen: Color = Color(0.0, 0.0, 0.0, 0.35)

  static barHeight: float = 38.0
  -- A window narrower than this keeps only the bar's first buttons.
  static narrowBelow: float = 360.0
  static footHeight: float = 22.0

  -- The page's margins.
  static margin: float = 18.0

  static fn theme() -> ThemeData
    return ThemeData(
      background: Look.page,
      surface: Look.card,
      border: Look.edge,
      text: Look.text,
      textMuted: Look.dimText,
      primary: Look.accent,
      body: TextStyle(Look.text, 13.0)
    )
  end
end
