-- A button of the toolbar: a word on a quiet pill, lit when it is a
-- switch that is on, dim when it can't be pressed.

from uikit import *
from Look import Look

export class ToolButton extends View
  label: string
  onPressed: Action
  on: boolean
  enabled: boolean

  fn init(
    label: string,
    onPressed: Action,
    on: boolean = false,
    enabled: boolean = true,
    key: string? = nil
  )
    self.super(key ?? label)
    self.label = label
    self.onPressed = onPressed
    self.on = on
    self.enabled = enabled
  end

  fn body(context: BuildContext) -> View
    local fill = Look.button
    if self.on then
      fill = Look.buttonOn
    end
    local ink = Look.text
    if not self.enabled then
      ink = Look.dimText
    end
    local label = Text(self.label).font(12.0).foregroundStyle(ink)
    local inset = EdgeInsets.symmetric(horizontal: 10.0, vertical: 4.0)
    local pill = label.padding(insets: inset).background(fill, 6.0)
    if not self.enabled then
      return pill
    end
    return GestureArea(child: pill, onTap: self.onPressed)
  end
end
