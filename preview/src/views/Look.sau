-- Preview's colours and sizes: dark, as the system is, with what is
-- looked at on a desk a little darker than the bar.

from uikit import Color, TextStyle, ThemeData

export class Look
  static window: Color = Color(0.15, 0.15, 0.17)
  static desk: Color = Color(0.11, 0.11, 0.13)
  static bar: Color = Color(0.19, 0.19, 0.21)
  static hairline: Color = Color(0.0, 0.0, 0.0, 0.45)
  static rule: Color = Color(1.0, 1.0, 1.0, 0.14)
  static text: Color = Color(0.95, 0.95, 0.97)
  static dimText: Color = Color(1.0, 1.0, 1.0, 0.55)
  static warning: Color = Color(1.0, 0.72, 0.42)
  static accent: Color = Color(0.25, 0.48, 0.90)
  static link: Color = Color(0.45, 0.66, 1.0)
  static button: Color = Color(1.0, 1.0, 1.0, 0.10)
  static buttonOn: Color = Color(1.0, 1.0, 1.0, 0.26)
  static well: Color = Color(0.0, 0.0, 0.0, 0.28)
  static card: Color = Color(0.19, 0.19, 0.21)
  static edge: Color = Color(1.0, 1.0, 1.0, 0.10)

  static barHeight: float = 40.0

  -- A window narrower than this leaves the document's name out of the
  -- bar.
  static narrowBelow: float = 520.0

  -- Room round a picture or a page, and the widest a page or a column
  -- of text is drawn when it is fitted to the window.
  static margin: float = 16.0
  static widest: float = 900.0
  static column: float = 720.0

  -- A typeface with heavier strokes, for bold: the system's own where
  -- it is found, else none, and bold is drawn as the rest is.
  static local boldFaces: table<string> = {
    "/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf",
    "/usr/share/fonts/TTF/DejaVuSans-Bold.ttf",
    "/usr/share/fonts/dejavu/DejaVuSans-Bold.ttf",
    "/System/Library/Fonts/Supplemental/Arial Bold.ttf",
    "C:\\Windows\\Fonts\\arialbd.ttf",
  }
  static local boldFound: boolean = false
  static local boldPath: string? = nil

  static fn boldFace() -> string?
    if not Look.boldFound then
      Look.boldFound = true
      for path in Look.boldFaces do
        if Look.boldPath == nil and Os.exists(path) then
          Look.boldPath = path
        end
      end
    end
    return Look.boldPath
  end

  static fn theme() -> ThemeData
    return ThemeData(
      background: Look.window,
      surface: Look.card,
      border: Look.edge,
      text: Look.text,
      textMuted: Look.dimText,
      primary: Look.accent,
      body: TextStyle(Look.text, 13.0)
    )
  end
end
