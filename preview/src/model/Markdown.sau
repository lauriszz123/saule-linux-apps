-- A Markdown file as what it says: blocks (headings, paragraphs, lists,
-- quotes, code, tables, rules, pictures), each of runs of text that are
-- plain, bold, italic, code or a link.
--
-- The Markdown read is the common kind: `#` and underlined headings,
-- `-`, `*`, `+` and numbered lists (nested by their indent, with task
-- boxes), `>` quotes, fenced code, tables with a `|---|` line under
-- their head, `---` rules, and in a line `**bold**`, `*italic*`,
-- `` `code` ``, `[links](to)`, `<links>` and `![pictures](of)`. What is
-- not understood is shown as it is written.

-- A run of text of one kind.
export class Run
  text: string
  bold: boolean
  italic: boolean
  code: boolean
  link: boolean

  fn init(
    text: string,
    bold: boolean = false,
    italic: boolean = false,
    code: boolean = false,
    link: boolean = false
  )
    self.text = text
    self.bold = bold
    self.italic = italic
    self.code = code
    self.link = link
  end
end

export enum BlockKind
  Heading,
  Paragraph,
  Code,
  Quote,
  Item,
  Rule,
  Table,
  Figure
end

export class Block
  kind: BlockKind
  -- A heading's level, from 1; a list item's depth, from 0.
  level: integer
  -- A list item's mark: a bullet, a number, a task's box.
  marker: string
  runs: table<Run>
  -- A code block's text, as written; a figure's file.
  text: string
  -- A table's rows, the head first: each a cell's runs.
  rows: table<table<table<Run>>>

  fn init(kind: BlockKind, runs: table<Run>? = nil)
    self.kind = kind
    self.level = 0
    self.marker = ""
    self.runs = runs ?? {}
    self.text = ""
    self.rows = {}
  end
end

export class Markdown
  -- Where `needle` starts in `text` at or after `start`, or 0.
  static fn indexOf(text: string, needle: string, start: integer) -> integer
    local length = String.len(text)
    local size = String.len(needle)
    local i = start
    while i + size - 1 <= length do
      if String.sub(text, i, i + size - 1) == needle then
        return i
      end
      i = i + 1
    end
    return 0
  end

  static fn isWord(c: string) -> boolean
    return (c >= "a" and c <= "z") or (c >= "A" and c <= "Z") or (c >= "0" and c <= "9")
  end

  static fn isDigit(c: string) -> boolean
    return c >= "0" and c <= "9"
  end

  -- A line's runs.
  static fn inline(text: string) -> table<Run>
    local out: table<Run> = {}
    local buffer = ""
    local bold = false
    local italic = false
    local length = String.len(text)
    local i = 1
    while i <= length do
      local c = String.sub(text, i, i)
      local after = ""
      if i < length then
        after = String.sub(text, i + 1, i + 1)
      end
      local before = ""
      if i > 1 then
        before = String.sub(text, i - 1, i - 1)
      end

      -- Where a mark is taken, `step` says how far to go on; 0 means the
      -- character is only itself.
      local step = 0
      if c == "\\" and after != "" then
        buffer = buffer .. after
        step = 2
      elseif c == "`" then
        local close = Markdown.indexOf(text, "`", i + 1)
        if close > 0 then
          if buffer != "" then
            Table.insert(out, Run(buffer, bold, italic))
            buffer = ""
          end
          local code = String.sub(text, i + 1, close - 1)
          Table.insert(out, Run(code, bold, italic, true))
          step = close - i + 1
        end
      elseif (c == "*" and after == "*") or (c == "_" and after == "_") then
        if buffer != "" then
          Table.insert(out, Run(buffer, bold, italic))
          buffer = ""
        end
        bold = not bold
        step = 2
      elseif c == "~" and after == "~" then
        step = 2
      elseif c == "*" or c == "_" then
        -- A mark opens before a letter and closes after one; an
        -- underscore inside a word is part of the word.
        local inside = c == "_" and Markdown.isWord(before) and Markdown.isWord(
          after
        )
        local opens = not italic and after != "" and after != " "
        local closes = italic and before != " "
        if not inside and (opens or closes) then
          if buffer != "" then
            Table.insert(out, Run(buffer, bold, italic))
            buffer = ""
          end
          italic = not italic
          step = 1
        end
      elseif c == "[" or (c == "!" and after == "[") then
        local open = i
        if c == "!" then
          open = i + 1
        end
        local middle = Markdown.indexOf(text, "](", open + 1)
        local close = 0
        if middle > 0 then
          close = Markdown.indexOf(text, ")", middle + 2)
        end
        if close > 0 then
          if buffer != "" then
            Table.insert(out, Run(buffer, bold, italic))
            buffer = ""
          end
          local label = String.sub(text, open + 1, middle - 1)
          if c == "!" then
            -- A picture in a line of text: what it is of.
            Table.insert(out, Run(label, bold, true))
          else
            Table.insert(out, Run(label, bold, italic, false, true))
          end
          step = close - i + 1
        end
      elseif c == "<" then
        local close = Markdown.indexOf(text, ">", i + 1)
        if close > 0 then
          local inner = String.sub(text, i + 1, close - 1)
          if String.starts(inner, "http://") or String.starts(inner, "https://") then
            if buffer != "" then
              Table.insert(out, Run(buffer, bold, italic))
              buffer = ""
            end
            Table.insert(out, Run(inner, bold, italic, false, true))
            step = close - i + 1
          end
        end
      end

      if step == 0 then
        buffer = buffer .. c
        step = 1
      end
      i = i + step
    end
    if buffer != "" then
      Table.insert(out, Run(buffer, bold, italic))
    end
    return out
  end

  -- How far a line is indented, in spaces: a tab is four.
  static fn indentOf(line: string) -> integer
    local n = 0
    for i = 1, String.len(line) do
      local c = String.sub(line, i, i)
      if c == " " then
        n = n + 1
      elseif c == "\t" then
        n = n + 4
      else
        return n
      end
    end
    return n
  end

  -- Whether a line is a rule: three or more of `-`, `*` or `_`, and
  -- nothing else but spaces.
  static fn isRule(line: string) -> boolean
    local marks = String.replace(String.trim(line), " ", "")
    if String.len(marks) < 3 then
      return false
    end
    local first = String.sub(marks, 1, 1)
    if first != "-" and first != "*" and first != "_" then
      return false
    end
    for i = 2, String.len(marks) do
      if String.sub(marks, i, i) != first then
        return false
      end
    end
    return true
  end

  -- Whether a line is all of `mark`: what underlines a heading.
  static fn isAll(line: string, mark: string) -> boolean
    local trimmed = String.trim(line)
    if String.len(trimmed) < 2 then
      return false
    end
    for i = 1, String.len(trimmed) do
      if String.sub(trimmed, i, i) != mark then
        return false
      end
    end
    return true
  end

  -- A list item's mark and what follows it, when the line (its indent
  -- taken off) starts one; "" and the line otherwise.
  static fn itemOf(line: string) -> (string, string)
    local first = String.sub(line, 1, 1)
    local second = String.sub(line, 2, 2)
    if (first == "-" or first == "*" or first == "+") and second == " " then
      local rest = String.trim(String.sub(line, 3))
      -- A task's box.
      if String.starts(rest, "[ ] ") then
        return "☐", String.sub(rest, 5)
      end
      if String.starts(rest, "[x] ") or String.starts(rest, "[X] ") then
        return "☑", String.sub(rest, 5)
      end
      return "•", rest
    end
    local digits = 0
    while Markdown.isDigit(String.sub(line, digits + 1, digits + 1)) do
      digits = digits + 1
    end
    if digits > 0 and digits <= 9 then
      local mark = String.sub(line, digits + 1, digits + 1)
      local space = String.sub(line, digits + 2, digits + 2)
      if (mark == "." or mark == ")") and space == " " then
        return String.sub(line, 1, digits) .. ".", String.trim(
          String.sub(line, digits + 3)
        )
      end
    end
    return "", line
  end

  -- A table's line as its cells.
  static fn cellsOf(line: string) -> table<string>
    local trimmed = String.trim(line)
    if String.starts(trimmed, "|") then
      trimmed = String.sub(trimmed, 2)
    end
    if String.ends(trimmed, "|") then
      trimmed = String.sub(trimmed, 1, String.len(trimmed) - 1)
    end
    local out: table<string> = {}
    for cell in String.split(trimmed, "|") do
      Table.insert(out, String.trim(cell))
    end
    return out
  end

  -- Whether a line is the one under a table's head: `|---|:--:|`.
  static fn isDivider(line: string) -> boolean
    local trimmed = String.trim(line)
    if not String.contains(trimmed, "-") or not String.contains(trimmed, "|") then
      return false
    end
    for i = 1, String.len(trimmed) do
      local c = String.sub(trimmed, i, i)
      if c != "|" and c != "-" and c != ":" and c != " " then
        return false
      end
    end
    return true
  end

  -- The whole of `text` as blocks. `folder` is where the file is: a
  -- picture named without one is looked for there.
  static fn parse(text: string, folder: string) -> table<Block>
    local lines = String.split(String.replace(text, "\r", ""), "\n")
    local out: table<Block> = {}
    -- The lines of the paragraph being gathered.
    local gathered: table<string> = {}
    local flush = fn()
      if #gathered == 0 then
        return
      end
      local joined = String.join(" ", gathered)
      gathered = {}
      -- A picture alone in its paragraph is a figure.
      if String.starts(joined, "![") and String.ends(joined, ")") then
        local middle = Markdown.indexOf(joined, "](", 3)
        if middle > 0 then
          local figure = Block(BlockKind.Figure)
          local alt = String.sub(joined, 3, middle - 1)
          local file = String.sub(joined, middle + 2, String.len(joined) - 1)
          figure.runs = {Run(alt, false, true)}
          figure.text = Markdown.fileOf(file, folder)
          Table.insert(out, figure)
          return
        end
      end
      Table.insert(out, Block(BlockKind.Paragraph, Markdown.inline(joined)))
    end

    local i = 1
    while i <= #lines do
      local line = lines[i]
      local trimmed = String.trim(line)
      local indent = Markdown.indentOf(line)
      local marker, rest = Markdown.itemOf(trimmed)

      if String.starts(trimmed, "```") or String.starts(trimmed, "~~~") then
        -- Fenced code: everything to the fence that closes it.
        flush()
        local fence = String.sub(trimmed, 1, 3)
        local code: table<string> = {}
        i = i + 1
        while i <= #lines and not String.starts(String.trim(lines[i]), fence) do
          Table.insert(code, lines[i])
          i = i + 1
        end
        local block = Block(BlockKind.Code)
        block.text = String.join("\n", code)
        Table.insert(out, block)
      elseif String.starts(trimmed, "<!--") then
        -- A comment: not shown.
        flush()
        while i <= #lines and not String.contains(lines[i], "-->") do
          i = i + 1
        end
      elseif trimmed == "" then
        flush()
      elseif #gathered > 0 and Markdown.isAll(trimmed, "=") then
        local heading = Block(
          BlockKind.Heading,
          Markdown.inline(String.join(" ", gathered))
        )
        heading.level = 1
        gathered = {}
        Table.insert(out, heading)
      elseif #gathered > 0 and Markdown.isAll(trimmed, "-") then
        local heading = Block(
          BlockKind.Heading,
          Markdown.inline(String.join(" ", gathered))
        )
        heading.level = 2
        gathered = {}
        Table.insert(out, heading)
      elseif Markdown.isRule(trimmed) then
        flush()
        Table.insert(out, Block(BlockKind.Rule))
      elseif String.starts(trimmed, "#") then
        flush()
        local level = 0
        while level < 6 and String.sub(trimmed, level + 1, level + 1) == "#" do
          level = level + 1
        end
        local title = String.trim(String.sub(trimmed, level + 1))
        -- Closing marks, as some write them: "## Title ##".
        while String.ends(title, "#") do
          title = String.trim(String.sub(title, 1, String.len(title) - 1))
        end
        local heading = Block(BlockKind.Heading, Markdown.inline(title))
        heading.level = level
        Table.insert(out, heading)
      elseif String.starts(trimmed, ">") then
        -- A quote: every line that starts with the mark, as one.
        flush()
        local quoted: table<string> = {}
        while i <= #lines and String.starts(String.trim(lines[i]), ">") do
          local said = String.trim(String.sub(String.trim(lines[i]), 2))
          if said != "" then
            Table.insert(quoted, said)
          end
          i = i + 1
        end
        i = i - 1
        Table.insert(
          out,
          Block(BlockKind.Quote, Markdown.inline(String.join(" ", quoted)))
        )
      elseif marker != "" then
        -- A list item, and the lines under it that carry it on.
        flush()
        local said: table<string> = {rest}
        while i < #lines do
          local following = lines[i + 1]
          local under = String.trim(following)
          local mark, more = Markdown.itemOf(under)
          if under == "" or mark != "" or Markdown.indentOf(following) <= indent then
            break
          end
          Table.insert(said, under)
          i = i + 1
        end
        local item = Block(
          BlockKind.Item,
          Markdown.inline(String.join(" ", said))
        )
        item.level = Math.min(indent / 2, 5)
        item.marker = marker
        Table.insert(out, item)
      elseif String.contains(trimmed, "|") and i < #lines and Markdown.isDivider(
        lines[i + 1]
      ) then
        flush()
        local table_ = Block(BlockKind.Table)
        local rows: table<table<table<Run>>> = {}
        local head: table<table<Run>> = {}
        for cell in Markdown.cellsOf(trimmed) do
          Table.insert(head, Markdown.inline(cell))
        end
        Table.insert(rows, head)
        i = i + 2
        while i <= #lines and String.contains(lines[i], "|") and String.trim(
          lines[i]
        ) != "" do
          local row: table<table<Run>> = {}
          for cell in Markdown.cellsOf(lines[i]) do
            Table.insert(row, Markdown.inline(cell))
          end
          Table.insert(rows, row)
          i = i + 1
        end
        i = i - 1
        table_.rows = rows
        Table.insert(out, table_)
      else
        Table.insert(gathered, trimmed)
      end
      i = i + 1
    end
    flush()
    return out
  end

  -- Where a picture named in a document is: as named when that is a
  -- whole path, else in the document's folder. "" for one on the web,
  -- which is not fetched.
  static fn fileOf(named: string, folder: string) -> string
    local file = String.trim(named)
    -- A title after the path, as `![a](b.png "title")`.
    local space = Markdown.indexOf(file, " ", 1)
    if space > 0 then
      file = String.sub(file, 1, space - 1)
    end
    if String.contains(file, "://") then
      return ""
    end
    if String.starts(file, "/") then
      return file
    end
    if String.ends(folder, "/") then
      return folder .. file
    end
    return folder .. "/" .. file
  end

  -- Runs as the plain text they say.
  static fn plain(runs: table<Run>) -> string
    local out = ""
    for run in runs do
      out = out .. run.text
    end
    return out
  end
end
