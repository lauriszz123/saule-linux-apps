-- Calendar's colours, sizes and names: dark, as the system is, with the
-- red a calendar marks today in.

from uikit import Color, Date, TextStyle, ThemeData

export class Look
  static window: Color = Color(0.15, 0.15, 0.17)
  static bar: Color = Color(0.19, 0.19, 0.21)
  static side: Color = Color(0.17, 0.17, 0.19)
  static hairline: Color = Color(0.0, 0.0, 0.0, 0.45)
  static rule: Color = Color(1.0, 1.0, 1.0, 0.08)
  static text: Color = Color(0.95, 0.95, 0.97)
  static dimText: Color = Color(1.0, 1.0, 1.0, 0.55)
  static faintText: Color = Color(1.0, 1.0, 1.0, 0.25)
  static warning: Color = Color(1.0, 0.72, 0.42)
  static accent: Color = Color(0.94, 0.30, 0.26)
  static tint: Color = Color(0.94, 0.30, 0.26, 0.28)
  static chosen: Color = Color(1.0, 1.0, 1.0, 0.07)
  static weekend: Color = Color(0.0, 0.0, 0.0, 0.10)
  static button: Color = Color(1.0, 1.0, 1.0, 0.10)
  static buttonOn: Color = Color(1.0, 1.0, 1.0, 0.26)
  static well: Color = Color(0.0, 0.0, 0.0, 0.25)
  static card: Color = Color(0.19, 0.19, 0.21)
  static edge: Color = Color(1.0, 1.0, 1.0, 0.10)
  static screen: Color = Color(0.0, 0.0, 0.0, 0.35)

  static barHeight: float = 40.0
  -- How wide the day's events are beside the month, and how tall under
  -- it in a window too narrow to have them beside.
  static sideWidth: float = 240.0
  static sideHeight: float = 170.0
  static narrowBelow: float = 620.0

  -- The days of the week, Sunday first, as `Date.weekday` counts them.
  static weekdays: table<string> = {
    "Sunday",
    "Monday",
    "Tuesday",
    "Wednesday",
    "Thursday",
    "Friday",
    "Saturday",
  }

  -- The name of `date`'s day of the week.
  static fn weekday(date: Date) -> string
    return Look.weekdays[date.weekday() + 1]
  end

  static fn theme() -> ThemeData
    return ThemeData(
      background: Look.window,
      surface: Look.card,
      border: Look.edge,
      text: Look.text,
      textMuted: Look.dimText,
      primary: Look.accent,
      body: TextStyle(Look.text, 13.0)
    )
  end
end
