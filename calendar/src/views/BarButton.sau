-- A button of the bar: a word on a rounded ground, lit when it is the
-- one in force, faint when it has nothing to do.

from uikit import *
from Look import Look

export class BarButton extends View
  label: string
  onPressed: Action
  on: boolean
  enabled: boolean
  fill: Color?

  fn init(
    label: string,
    onPressed: Action,
    on: boolean = false,
    enabled: boolean = true,
    fill: Color? = nil,
    key: string? = nil
  )
    self.super(key ?? label)
    self.label = label
    self.onPressed = onPressed
    self.on = on
    self.enabled = enabled
    self.fill = fill
  end

  fn body(context: BuildContext) -> View
    local fill = self.fill ?? Look.button
    if self.on then
      fill = Look.buttonOn
    end
    local ink = Look.text
    if not self.enabled then
      ink = Color(1.0, 1.0, 1.0, 0.25)
      fill = Look.button
    end
    local label = Text(self.label).font(12.0).foregroundStyle(ink)
    local inset = EdgeInsets.symmetric(horizontal: 10.0, vertical: 4.0)
    local pill = label.lineLimit(1).padding(insets: inset).background(fill, 6.0)
    if not self.enabled then
      return pill
    end
    return GestureArea(child: pill, onTap: self.onPressed)
  end
end
